		Is Button Held(Event Player, Button(Ability 1)) == True;
		Is Crouching(Event Player) == True;
		Event Player.BhopReady == False;
	}
	actions
	{
		Small Message(Event Player, Custom String("Regen bhop!", Event Player));
		Event Player.BhopActive = True;
	}
}
