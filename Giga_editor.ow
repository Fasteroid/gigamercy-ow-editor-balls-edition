variables
{
	global:
        0: MapData
		1: DebugMode
        2: Colors
        3: HintText
		4: Config
		5: WorkshopColorList
		6: Checkpoints
		8: Orbs
		9: AntiOrbs
		10: RefreshOrbs
		11: Bots
		12: Clouds
		13: Teleports
		14: CompressedData
		15: TawsEditorVariables
		16: DefaultCheckpointRadius
		17: DefaultOrbRadius
		18: DefaultRefreshOrbRadius
		19: i
		20: j
		21: TempArray

	player:
		0: Checkpoint
		1: Finished
		2: FreeMode
		3: CurrentRunTime
		4: OrbEffects
		5: OrbIcons
		6: BotEffects
		7: BotIcons
		8: CloudEffects
		9: SphereEffects
		10: CheckpointEffects
		11: CheckpointIcons
		12: CheckpointText
}

subroutines
{
	0: InitializeGlobalVariables
	1: InitializePlayerVariables
	2: DecompressMapData
	3: CreateGlobalHUD
	4: CreatePlayerHUD
	5: CreateCurrentLevel
	6: TeleportToCurrentCheckpoint
	7: TawsDecompressData
}


rule("Put your data here")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		
	}
}
rule("Effect Color List")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		"Checkpoint Ring Color"
		Global.Config[0] = Color(Blue);
		"Orb color"
		Global.Config[1] = Color(Red);
		"Anti-Orb Color"
		Global.Config[2] = Color(Yellow);
		"Jump Cloud Color"
		Global.Config[3] = Color(Red);
	}
}

rule("--------------------------Initialization Settings------------------------------")
{
	event
	{
		Ongoing - Global;
	}
}

rule("1. Global Initialization")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		Enable Inspector Recording;
		Disable Built-In Game Mode Announcer;
		Disable Built-In Game Mode Completion;
		Disable Built-In Game Mode Music;
		Disable Built-In Game Mode Scoring;
		If(Current Game Mode != Game Mode(Skirmish));
			Set Match Time(1);
		End;
		Pause Match Time;

		"TEMPORAL, JUST FOR TAWS COMPATIBILITY"
		Global.DefaultCheckpointRadius = 2;
	}
}

rule("2. Player Initialization")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Has Spawned(Event Player) == True;
	}

	actions
	{
		Small Message(Event Player, Custom String("Initializing player..."));
		"Disable gamemode stuff"
		Disable Built-In Game Mode Respawning(Event Player);
		If(Current Game Mode != Game Mode(Skirmish));
			Disable Game Mode HUD(Event Player);
		End;
		Enable Death Spectate All Players(Event Player);
		Enable Death Spectate Target HUD(Event Player);
		
		Call Subroutine(InitializePlayerVariables);
		Call Subroutine(CreatePlayerHUD);
		Call Subroutine(CreateCurrentLevel);
		Call Subroutine(TeleportToCurrentCheckpoint);
	}
}

rule("3. Decompress Data")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		CallSubroutine(InitializeGlobalVariables);
		"Detect GigaEditor data"
		If (Global.MapData);
			Call Subroutine(DecompressMapData);
			
		"Detect Taw's Editor data"
		Else If (Global.CompressedData);
			Call Subroutine(TawsDecompressData);
		End;
	}
}
rule("-----------------------------Effects-------------------------------")
{
	event
	{
		Ongoing - Global;
	}
}


rule("--------------------------Subroutines------------------------------")
{
	event
	{
		Ongoing - Global;
	}
}

rule("Subroutine InitializeGlobalVariables")
{
	event
	{
		Subroutine;
		InitializeGlobalVariables;
	}

	actions
	{
		Global.DebugMode = Workshop Setting Toggle(Custom String("Giga editor options"), Custom String("Debug Mode (Inspector Recording)"),
			False, 0);
		Call Subroutine(CreateGlobalHUD);
		Global.Checkpoints = Empty Array;
		Global.Bots = Empty Array;
		Global.Orbs = Empty Array;
		Global.AntiOrbs = Empty Array;
		Global.RefreshOrbs = Empty Array;
		Global.Teleports = Empty Array;
	}
}

rule("Subroutine InitializePlayerVariables")
{
	event
	{
		Subroutine;
		InitializePlayerVariables;
	}

	actions
	{
		Small Message(Event Player, Custom String("Welcome"));
		Event Player.Checkpoint = 0;
		Event Player.Finished = False;
		Event Player.FreeMode = False;
		Event Player.CurrentRunTime = 0;
	}
}

rule("Subroutine DecompressMapData")
{
	event
	{
		Subroutine;
		DecompressMapData;
	}
}

rule("Subroutine CreateGlobalHUD")
{
	event
	{
		Subroutine;
		CreateGlobalHUD;
	}

	actions
	{
		"Map Creator and code"
		Create HUD Text(All Players(All Teams), Custom String("Giga's Parkour Editor"), Custom String("Subheader"), Custom String("Text"),
			Left, 0, Color(Green), Color(White), Color(Red), Visible To and String, Default Visibility);
		"Leaderboard"
		Create HUD Text(All Players(All Teams), Null, Custom String("Leaderboard:"), Null,
			Left, 0, Null, Color(White), Null, Visible To and String, Default Visibility);
		"Instructions"
		Create HUD Text(All Players(All Teams), Null, Custom String("Double click {0} to show or hide controls", Input Binding String(Button(Interact))), Null,
			Right, 0, Null, Color(Gray), Null, Visible To and String, Default Visibility);
		
		
	}
}

rule("Subroutine CreatePlayerHUD")
{
	event
	{
		Subroutine;
		CreatePlayerHUD;
	}

	actions
	{
		Small Message(Event Player, Custom String("Player HUD"));
	}
}

rule("Subroutine CreateCurrentLevel")
{
	event
	{
		Subroutine;
		CreateCurrentLevel;
	}

	actions
	{
		
		"Create Start Checkpoint"
		Create Effect(Event Player, Ring, Global.Config[0], Global.MapData[Event Player.Checkpoint][0], Global.MapData[Event Player.Checkpoint][1], Visible To Position and Radius);
		Modify Player Variable(Event Player, CheckpointEffects, Append To Array, Last Created Entity);
		Create In-World Text(Event Player, Custom String("Checkpoint"), Global.MapData[Event Player.Checkpoint][0], 1, Clip Against Surfaces, Visible To and String, Color(White), Default Visibility); 
		Modify Player Variable(Event Player, CheckpointText, Append To Array, Last Created Entity);


		"Create Orbs"
		Create Effect(Event Player, Orb, Global.Config[1], Global.MapData[Event Player.Checkpoint][0], Global.MapData[Event Player.Checkpoint][1], Visible To Position and Radius);
		
		Modify Player Variable(Event Player, CheckpointEffects, Append To Array, Last Created Entity);
		Create In-World Text(Event Player, Custom String("Orb"), Global.MapData[Event Player.Checkpoint][0], 1, Clip Against Surfaces, Visible To and String, Color(White), Default Visibility); 

		"Create Bot"
		Create Effect(Event Player, Ring, Global.Config[0], Global.MapData[Event Player.Checkpoint][0], Global.MapData[Event Player.Checkpoint][1], Visible To Position and Radius);
		Create In-World Text(Event Player, Custom String("Checkpoint"), Global.MapData[Event Player.Checkpoint][0], 1, Clip Against Surfaces, Visible To and String, Color(White), Default Visibility); 

	}
}

rule("Subroutine Taw's Editor Decompression")
{
	event
	{
		Subroutine;
		TeleportToCurrentCheckpoint;
	}

	actions
	{
		Teleport(Event Player, Global.MapData[Event Player.Checkpoint][0]);
	}
}

rule("Taw's Editor DecompressData()")
{
	event
	{
		Subroutine;
		TawsDecompressData;
	}

	actions
	{
		Global.TawsEditorVariables = Empty Array;
		"ctemp"
		Global.i = 0;
		"temp"
		Global.TawsEditorVariables[1] = Empty Array;
		"CheckpointFlags"
		Global.TawsEditorVariables[2] = Empty Array;
		"Orb/Refresh Orb index"
		Global.j = 0;
		"Orb/Antiorb data"
		Global.TawsEditorVariables[4] = Empty Array;

		"Compression V2"
		If(Global.CompressedData[Count Of(Global.CompressedData) - 1] == 2);
			Global.CompressedData = Array Slice(Global.CompressedData, 0, Count Of(Global.CompressedData) - 1);
			"Extract Teleport pads"
			Global.Teleports = Mapped Array(Global.CompressedData, Current Array Element[0][3][0]!= 0 ? Array(Current Array Element[0][3][0],
			Current Array Element[0][3][1], False, Current Array Element[0][3][2],Current Array Element[0][3][3]) : False);
			"//TODO: Extraer estas flags"
			Global.TawsEditorVariables[2] = Mapped Array(Mapped Array(Global.CompressedData, Array(Current Array Element[4] % 8, Round To Integer((
				Current Array Element[4] - Round To Integer(Current Array Element[4] / 1000, Down) * 1000) / 10, Down) / 10, Round To Integer(
				Current Array Element[4] / 1000, Down) / 10)), Array(Current Array Element[0] % 2 != 0, 0, (
				Current Array Element[0] - Current Array Element[0] % 2) % 4 != 0, (Current Array Element[0] - Current Array Element[0] % 4)
				% 8 != 0, 0, Current Array Element[2], Current Array Element[1]));
		
		"Compression V1"
		Else If(Global.CompressedData[Count Of(Global.CompressedData) - 1] == 1);
			Global.CompressedData = Array Slice(Global.CompressedData, 0, Count Of(Global.CompressedData) - 1);
			"Extract Teleport pads"
			Global.Teleports = Mapped Array(Global.CompressedData, 
				Array(Current Array Element[0][2],
				Global.DefaultCheckpointRadius, 
				False, 
				Global.DefaultCheckpointRadius, 
				Global.DefaultCheckpointRadius));

			Global.TawsEditorVariables[2] = Mapped Array(Global.CompressedData, Array(Current Array Element[4] % 2 != 0, 0, (
				Current Array Element[4] - Current Array Element[4] % 2) % 4 != 0, (Current Array Element[4] - Current Array Element[4] % 4)
				% 8 != 0, 0, Global.DefaultCheckpointRadius, (Current Array Element[4] - Current Array Element[4] % 4)
				% 8 != 0 ? 0.200 : Global.DefaultCheckpointRadius));
		"Compression V0"
		Else;	
			"Extract Teleports"
			Global.Teleports = Mapped Array(Global.CompressedData, Array(Current Array Element[0][1], Global.DefaultCheckpointRadius,
				Global.DefaultCheckpointRadius, Global.DefaultCheckpointRadius, False));
			Global.TawsEditorVariables[2] = Mapped Array(Global.CompressedData, Array(Current Array Element[4] % 2 != 0, 0, (
				Current Array Element[4] - Current Array Element[4] % 2) % 4 != 0, (Current Array Element[4] - Current Array Element[4] % 4)
				% 8 != 0, 0, Global.DefaultCheckpointRadius, (Current Array Element[4] - Current Array Element[4] % 4)
				% 8 != 0 ? 0.200 : Global.DefaultCheckpointRadius));
		End;

		"Extract Checkpoint coordinates, radius and facing direction"
			Global.Checkpoints = Mapped Array(Global.CompressedData, Array(Current Array Element[0][0],
			Current Array Element[0][1] == 0 ? Global.DefaultCheckpointRadius : Current Array Element[0][1],
			Current Array Element[0][2] == 0 ? False : Current Array Element[0][2]));                                       

		"Extract Bots, Orbs, Flags"
		For Global Variable(i, 0, Count Of(Global.Checkpoints), 1);
			Global.TempArray = Empty Array;
			"Bots"
			For Global Variable(j, 0, Count Of(Global.CompressedData[Global.i][1]), 2);
				"Translate bot data and flags -> Array(Coords, CrouchEnabled, GravityEnabled)"
				Global.TempArray[Global.j / 2] =
					Array(Global.CompressedData[Global.i][1][Global.j],
						(Global.CompressedData[Global.i][1][Global.j + 1] % 2 != 0),
						((Global.CompressedData[Global.i][1][Global.j + 1] - Global.CompressedData[Global.i][1][Global.j + 1] % 2) % 4 != 0)
					);
			End;
			"Store Bot array to global data"
			Global.Bots[Global.i] = Global.TempArray;
			Global.TempArray = Empty Array;			

			"Extract Orbs/Antiorbs for this level"
			For Global Variable(j, 0, Count Of(Global.CompressedData[Global.i][2]), 2);
				"Transform orb data"
				Global.TempArray[Global.j / 2] =  Array(
					Global.CompressedData[Global.i][2][Global.j],
					Global.CompressedData[Global.i][2][Global.j + 1]);
				
			End;
			"Store Orb Array to global data"
			Global.Orbs[Global.i] = Filtered Array(Global.TempArray, Current Array Element[1] > 0);
			"Antiorbs are encoded with a negative Radius"
			Global.AntiOrbs[Global.i] = Mapped Array(Filtered Array(Global.TempArray, Current Array Element[1] < 0), Array(Current Array Element[0],Current Array Element[1] * -1));
			Global.TempArray = Empty Array;		

			"Extract Refresh Orbs"
			For Global Variable(j, 0, Count Of(Global.CompressedData[Global.i][3]), 2);
				"Transform Refresh Orb data"
				Global.TempArray[Global.j / 2] = Array(
					Global.CompressedData[Global.i][3][Global.j],
					Global.CompressedData[Global.i][3][Global.j + 1],
					Global.j / 2 + 1);
			End;
			Global.RefreshOrbs[Global.i] = Global.TempArray;
			Global.TempArray = Empty Array;		

			Wait(0.016, Ignore Condition);
		End;
		Global.CompressedData = Null;
		Global.TawsEditorVariables = Null;
		Global.TempArray = Null;
		Global.i = 0;
		Global.j = 0;
	}
}