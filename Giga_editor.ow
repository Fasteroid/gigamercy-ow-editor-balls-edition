		Visible To Position and Color, 
		Global.Checkpoints[Event Player.Checkpoint][3] ? Global.Settings[20] : Global.Settings[19], 
		True);
		Modify Player Variable(Event Player, BotIcons, Append To Array, Last Created Entity);
	}
}
rule("Create Teleport Effects")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Has Spawned(Event Player) == True;
		Is Dummy Bot(Event Player) == False;
	}
	actions
	{
		"For now we assume theres only one teleport pad per level, no need for multiple effect handling"
		Create Effect(Global.Teleports[Event Player.Checkpoint] ? Event Player : Null,
		Bad Aura,
		Global.Settings[9],
		Global.Teleports[Event Player.Checkpoint][0],
		Global.Teleports[Event Player.Checkpoint][1],
		Visible To Position Radius and Color);
	}
}
rule("Calculate RGB values for rainbow text")
{
	event
	{
		Ongoing - Global;
	}
	conditions
	{
		GLobal.DebugMode == False;
	}
	actions
	{
		While(Global.RGB[1] < 255);
			Global.RGB[1] += 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[2] > 0);
			Global.RGB[2] -= 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[0] < 255);
			Global.RGB[0] += 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[1] > 0);
			Global.RGB[1] -= 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[2] < 255);
			Global.RGB[2] += 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[0] > 0);
			Global.RGB[0] -= 3;
			Wait(0.016, Ignore Condition);
		End;
		Loop;
	}
}
