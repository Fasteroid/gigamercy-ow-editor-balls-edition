variables
{
	global:
        0:  MapData
		1:  DebugMode
        2:  Colors
        3:  HintText
		4:  Config
		5:  WorkshopColorList
		6:  Checkpoints
		8:  Orbs
		9:  AntiOrbs
		10: RefreshOrbs
		11: Bots
		12: Clouds
		13: Teleports
		14: CompressedData
		15: TawsEditorVariables
		16: DefaultCheckpointRadius
		17: DefaultOrbRadius
		18: DefaultRefreshOrbRadius
		19: i
		20: j
		21: TempArray

	player:
		0:  Checkpoint
		1:  Finished
		2:  FreeMode
		3:  CurrentRunTime
		4:  OrbEffects
		5:  OrbIcons
		6:  AntiOrbEffects
		7:  RefreshOrbEffects
		8:  RefreshOrbIcons
		9:  BotEffects
		10: BotIcons
		11: CloudEffects
		12: SphereEffects
		13: CheckpointEffects
		14: CheckpointIcons
		15: CheckpointText
		16: ToggleControls
}

subroutines
{
	0: InitializeGlobalVariables
	1: InitializePlayerVariables
	2: DecompressMapData
	3: CreateGlobalHUD
	4: CreatePlayerHUD
	5: SetupCheckpoint
	6: TeleportToCurrentCheckpoint
	7: TawsDecompressData
	8: PeaceDecompressData
	9: CreateCheckpoints
	10: DestroyExcessEffects
}


