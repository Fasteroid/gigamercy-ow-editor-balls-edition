rule("EditMode: Menu option definitions")
{
    event
    {
        Ongoing - Global;
    }
    conditions
    {
        
    }
    actions
    {
        "Main Screen"
        Global.PaletteMenu[0] = Array(
			Custom String("{0}\nCheckpoints", Icon String(Flag)),
			Custom String("{0}\nOrbs", Icon String(Circle)),
			Custom String("{0}\nBots", Ability Icon String(Hero(Ashe), Button(Ultimate))), 
			Custom String("{0}\nJump pads", Ability Icon String(Hero(Baptiste), Button(Crouch))),
			Custom String("{0}\nDecoration", Icon String(Dizzy)),
			Custom String("{0}\nTools", Icon String(Bolt)), 
			Custom String("{0}\nGeneral Options", Ability Icon String(Hero(Torbjörn), Button(Ability 2))));
		
		Global.MenuOptionsNames = Array(
			Custom String("Checkpoint"),
			Custom String("Orb"),
			Custom String("Refresh Orb"),
			Custom String("Bot"),
			Custom String("AntiOrb"),
			Custom String("Cloud"),
			Custom String("Teleport"));
		"Checkpoint Screen"
		Global.MenuOptions[0] = Custom String(
			"Position:\nRadius:\nFacing:\nCrouch:\nRequire ground:\nThreshold Above:\nThreshold Below:\nUnlimited GA:\n"
		);
        "Orbs Screen"
        Global.MenuOptions[1] = Custom String(
			"Position:\nRadius:\n");
		
		"Refresh Orbs Screen"
		Global.MenuOptions[2] = Custom String(
			"Position:\nRadius:\nBot section:\nRefresh A1:\nRefresh A2:\nRefresh Ult:\n");

        "Bots Screen"
        Global.MenuOptions[3] = Custom String(
			"Position:\nFacing:\nCrouch:\nGravity:\nRequire Kill/Rez:\nRefresh GA:\nUse Ability1:\nUse Ability 2:\nUse Ult:\nShoot:\nHold:\n{0}", Custom String("-----Level Overrides-----\nScale:\nHealth:\n"));
		
        "AntiOrbs Screen"
        Global.MenuOptions[4] = Custom String(
			"Position:\nRadius:\n");
		
        "Clouds Screen"
        Global.MenuOptions[5] = Custom String(
			"Position:\nRadius:\nMagnitude:\n");

		"Teleports Screen"
        Global.MenuOptions[6] = Custom String(
			"Position:\nRadius:\nTP Coords:\nThreshold Above:\nThreshold Below:\n");

        "Create menu background. Width 54, 18 lines"
        Create Hud Text(Local Player.MenuOpen ? Local Player : Null, Custom String("     {0} {1}\n{2}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", Global.MenuOptionsNames[Local Player.MenuPage], Local Player.ObjectIndex, Evaluate Once(String Slice(Global.EnPadding, 0, 54))), Null, Null, Top, 10, Custom Color(0,255,0,128), Color(White), Color(White), Visible To And String, Default Visibility);

    }
}
disabled rule("EditMode: Hold [Interact] to open menu")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		"TODO: Only allow this for players with edit permissions"
		Global.EditMode == True;
		Is Button Held(Event Player, Button(Interact)) == True;
		Is Button Held(Event Player, Button(Ability 1)) == False;
		Is Button Held(Event Player, Button(Ability 2)) == False;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Melee)) == False;
	}
	actions
	{
		Log To Inspector(Custom String("{0} - Toggle menu", Event Player));
		Wait(0.2, Abort When False);
		Event Player.MenuOpen = !Event Player.MenuOpen;
		If(Event Player.MenuOpen);
			Set Move Speed(Event Player, 0);
			Set Jump Enabled(Event Player, False);
		Else;
			Set Move Speed(Event Player, 100);
			Set Jump Enabled(Event Player, Event Player.FreeMode ? True : Event Player.Jump);
		End;
		Set Primary Fire Enabled(Event Player, !Event Player.MenuOpen);
		Set Secondary Fire Enabled(Event Player, !Event Player.MenuOpen);
		Call Subroutine(GetEditMenuTempData);
	}
}
rule("EditMode: Use [Movement Keys] to navigate the menu")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		"TODO: Only allow this for players with edit permissions"
		Global.EditMode == True;
		Event Player.MenuOpen == True;
		Z Component Of(Throttle Of(Event Player)) != 0;
	}
	actions
	{
		If (Z Component Of(Throttle Of(Event Player)) < 0);
			Event Player.MenuCursor = (Event Player.MenuCursor + 1) % Value In Array(Array(8, 2, 6, 6, 2, 3, 5), Event Player.MenuPage);
		Else If (Z Component Of(Throttle Of(Event Player)) > 0);
			Event Player.MenuCursor = (Event Player.MenuCursor + (Value In Array(Array(8, 2, 6, 6, 2, 3, 5), Event Player.MenuPage)) -1) % Value In Array(Array(8, 2, 6, 6, 2, 3, 5), Event Player.MenuPage);
		End;
		Play Effect(Event Player, Widowmaker Venom Mine Explosion Sound , Null, Position Of(Event Player), 60);
		Wait(0.15, Abort When False);
		Loop If Condition Is True;
	}
}
rule("EditMode: Press [Jump] in menu to edit the attribute")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		"TODO: Only allow this for players with edit permissions"
		Global.EditMode == True;
		Event Player.MenuOpen == True;
		Is Button Held(Event Player, Button(Jump)) == True;
	}
	actions
	{
		If(Event Player.MenuCursor == 0);
			Small Message(Event Player, Custom String("Cant change object coordinates with this menu"));
			Play Effect(Event Player, Debuff Impact Sound, Null, Event Player, 100);
			Abort;
		End;
		"TODO: This does not reflect changes to crouch enabled immediately, fix pls"
		If(Event Player.MenuPage == 0);
			Call Subroutine(SetCurrentAbilities);
		End;
		Call Subroutine(EditSelectedObject);
		Call Subroutine(GetEditMenuTempData);
		Wait(0.2, Ignore Condition);
	}
}
rule("EditMode: Press [Melee] + [Primary/Secondary Fire] to select next/previous object")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		"TODO: Only allow this for players with edit permissions"
		Global.EditMode == True;
		"developer.Mind = Blown"
		Is Button Held(Event Player, Button(Melee)) == True;
		(Is Button Held(Event Player, Button(Primary Fire)) !=
		Is Button Held(Event Player, Button(Secondary Fire))) == True;
		Is Button Held(Event Player, Button(Ability 2)) == False;
		Is Button Held(Event Player, Button(Interact)) == False;
		Is Button Held(Event Player, Button(Crouch)) == False;
		"// TODO: Disabled because it caused issues when gliding, consider reenabling"
		disabled Is Button Held(Event Player, Button(Jump)) == False;
		Is Button Held(Event Player, Button(Ability 1)) == False;
		Is Button Held(Event Player, Button(Ultimate)) == False;
		Is Button Held(Event Player, Button(Reload)) == False;
	}
	actions
	{
		Event Player.ObjectIndex += (Is Button Held(Event Player, Button(Primary Fire)) ? 1 : -1);
		Call Subroutine(SetEditModeObjectIndex);

		Play Effect(Event Player, Buff Impact Sound, Null, Event Player, 100);
		
		If(Event Player.MenuOpen);
			Call Subroutine(GetEditMenuTempData);
		End;
		Wait(0.2, Restart When True);
		Small Message(Event Player, Custom String("Selected {0} {1} {2}", Global.MenuOptionsNames[Event Player.MenuPage], Event Player.MenuPage == 3 ? Custom String("section") : Custom String("index"),Event Player.ObjectIndex));
	}
}
rule("EditMode: Press [Interact]  + [Primary Fire] to insert object")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		"TODO: Only allow this for players with edit permissions"
		Global.EditMode == True;
		Is Button Held(Event Player, Button(Interact)) == True;
		Is Button Held(Event Player, Button(Primary Fire)) == True;
		Is Button Held(Event Player, Button(Secondary Fire)) == False;
		Is Button Held(Event Player, Button(Melee)) == False;
		Is Button Held(Event Player, Button(Ability 1)) == False;
		Is Button Held(Event Player, Button(Ability 2)) == False;
		Is Button Held(Event Player, Button(Crouch)) == False;
		"// TODO: Disabled because it caused issues when gliding, consider reenabling"
		disabled Is Button Held(Event Player, Button(Jump)) == False;
		Is Button Held(Event Player, Button(Ultimate)) == False;
		Is Button Held(Event Player, Button(Reload)) == False;
	}
	actions
	{
		If(Event Player.MenuPage == 0);
			Small Message(Event Player, Custom String("Hold for 1s to add a new checkpoint"));
			Wait(1, Abort When False);
			Small Message(Event Player, Custom String("checkpoint would be added here"));
			Play Effect(Event Player, Buff Impact Sound, Null, Event Player, 100);
			Abort;
		End;
		"TODO: BERI DAENDARIS"
		Event Player.Temp = Event Player.NewObjectDefaults[Event Player.MenuPage]; 
		Event Player.Temp[0] = Position Of(Event Player);

		"Heres hoping blzz wont change this broken method and also that they add real switch/case"
		If(True);
			Skip(Event Player.MenuPage * 4);
			Small Message(Event Player, Custom String("Inserting checkpoint too hard yet sry :/"));
			disabled End;
			disabled End;
			Else;
			Skip If(Global.Orbs[Event Player.Checkpoint] != False, 1);
			Global.Orbs[Event Player.Checkpoint] = Empty Array;
			Modify Global Variable At Index(Orbs, Event Player.Checkpoint, Append To Array, Array(Event Player.Temp));
			Else;
			Skip If(Global.RefreshOrbs[Event Player.Checkpoint] != False, 1);
			Global.RefreshOrbs[Event Player.Checkpoint] = Empty Array;
			Modify Global Variable At Index(RefreshOrbs, Event Player.Checkpoint, Append To Array, Array(Event Player.Temp));
			Else;
			Skip If(Global.Bots[Event Player.Checkpoint] != False, 1);
			Global.Bots[Event Player.Checkpoint] = Empty Array;
			Modify Global Variable At Index(Bots, Event Player.Checkpoint, Append To Array, Array(Event Player.Temp));
			Else;
			Skip If(Global.AntiOrbs[Event Player.Checkpoint] != False, 1);
			Global.AntiOrbs[Event Player.Checkpoint] = Empty Array;
			Modify Global Variable At Index(AntiOrbs, Event Player.Checkpoint, Append To Array, Array(Event Player.Temp));
			Else;
			Skip If(Global.Clouds[Event Player.Checkpoint] != False, 1);
			Global.Clouds[Event Player.Checkpoint] = Empty Array;
			Modify Global Variable At Index(Clouds, Event Player.Checkpoint, Append To Array, Array(Event Player.Temp));
			Else;
			disabled Skip If(Global.Teleports[Event Player.Checkpoint] != False, 1);
			disabled Global.Teleports[Event Player.Checkpoint] = Empty Array;
			disabled Modify Global Variable At Index(Teleports, Event Player.Checkpoint, Append To Array, Array(Event Player.Temp));
			Small Message(Event Player, Custom String("Inserting Teleports too hard yet sry :/"));
			Else;
		End;
		Event Player.ObjectIndex = -1;
		Call Subroutine(SetEditModeObjectIndex);

		Play Effect(Event Player, Buff Impact Sound, Null, Event Player, 100);
		Small Message(Event Player, Custom String("Created new {0} {1} {2}", Global.MenuOptionsNames[Event Player.MenuPage], Event Player.MenuPage == 3 ? Custom String("section") : Custom String("index"),Event Player.ObjectIndex));
		
		If(Event Player.MenuOpen);
			Call Subroutine(GetEditMenuTempData);
		End;
		Wait(0.2, Ignore Condition);
	}
}
rule("EditMode: Press [Interact] + [Secondary Fire] to delete the selected object")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		"TODO: Only allow this for players with edit permissions"
		Global.EditMode == True;
		Is Button Held(Event Player, Button(Interact)) == True;
		Is Button Held(Event Player, Button(Secondary Fire)) == True;
		Is Button Held(Event Player, Button(Primary Fire)) == False;
		Is Button Held(Event Player, Button(Melee)) == False;
		Is Button Held(Event Player, Button(Ability 1)) == False;
		Is Button Held(Event Player, Button(Ability 2)) == False;
		Is Button Held(Event Player, Button(Crouch)) == False;
		"// TODO: Disabled because it caused issues when gliding, consider reenabling"
		disabled Is Button Held(Event Player, Button(Jump)) == False;
		Is Button Held(Event Player, Button(Ultimate)) == False;
		Is Button Held(Event Player, Button(Reload)) == False;
	}
	actions
	{
		Small Message(Event Player, Custom String("Hold {0} + {1} for 1s to delete {2}", Input Binding String(Button(Interact)),Input Binding String(Button(Secondary Fire)), Global.MenuOptionsNames[Event Player.MenuPage]));
		Wait(1, Abort When False);
		If(Event Player.MenuPage == 0);
			Play Effect(Event Player, Debuff Impact Sound, Null, Event Player, 100);
			disabled Small Message(Event Player, Custom String("Hold {0} + {2} for 1s to delete checkpoint", Input Binding String(Button(Melee)),Input Binding String(Button(Primary Fire)),Input Binding String(Button(Secondary Fire))));
			disabled Wait(1, Abort When False);
			Small Message(Event Player, Custom String("checkpoint would be deleted here"));
			Play Effect(Event Player, Buff Impact Sound, Null, Event Player, 100);
			Abort;
		End;
		"Heres hoping blzz wont change this broken method and also that they add real switch/case"
		If(True);
			Skip(Event Player.MenuPage * 2);
			Small Message(Event Player, Custom String("Deleting cp not implemented yet"));
			Else;
			Modify Global Variable At Index(Orbs, Event Player.Checkpoint, Remove From Array By Index, Event Player.ObjectIndex);
			Else;
			Modify Global Variable At Index(RefreshOrbs, Event Player.Checkpoint, Remove From Array By Index, Event Player.ObjectIndex);
			Else;
			Modify Global Variable At Index(Bots, Event Player.Checkpoint, Remove From Array By Index, Event Player.ObjectIndex);
			Else;
			Modify Global Variable At Index(AntiOrbs, Event Player.Checkpoint, Remove From Array By Index, Event Player.ObjectIndex);
			Else;
			Modify Global Variable At Index(Clouds, Event Player.Checkpoint, Remove From Array By Index, Event Player.ObjectIndex);
			Else;
			Modify Global Variable At Index(Teleports, Event Player.Checkpoint, Remove From Array By Index, Event Player.ObjectIndex);
			Else;
		End;
		Event Player.ObjectIndex = -1;
		Call Subroutine(SetEditModeObjectIndex);

		Play Effect(Event Player, Buff Impact Sound, Null, Event Player, 100);
		Small Message(Event Player, Custom String("Deleted {0} {1} {2}", Global.MenuOptionsNames[Event Player.MenuPage], Event Player.MenuPage == 3 ? Custom String("section") : Custom String("index"),Event Player.ObjectIndex));
		
		If(Event Player.MenuOpen);
			Call Subroutine(GetEditMenuTempData);
		End;
		Wait(0.2, Ignore Condition);
	}
}
disabled rule("EditMode: Press [Interact] + [Melee] + [Primary/Secondary Fire] to switch menu page/object type")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		"TODO: Only allow this for players with edit permissions"
		Global.EditMode == True;
		Is Button Held(Event Player, Button(Interact)) == True;
		Is Button Held(Event Player, Button(Melee)) == True;
		(Is Button Held(Event Player, Button(Primary Fire)) ||
		Is Button Held(Event Player, Button(Secondary Fire))) == True;
	}
	actions
	{
		Log To Inspector(Custom String("{0} - Switch page", Event Player));
		If(Is Button Held(Event Player, Button(Primary Fire)));
			Event Player.MenuPage = (Event Player.MenuPage + 1) % Evaluate Once(Count Of(Global.MenuOptions));
			Play Effect(Event Player, Buff Impact Sound, Null, Event Player, 100);
		Else;
			Event Player.MenuPage = (Event Player.MenuPage + Evaluate Once(Count Of(Global.MenuOptions) - 1)) % Evaluate Once(Count Of(Global.MenuOptions));
			Play Effect(Event Player, Debuff Impact Sound, Null, Event Player, 100);
		End;
		Event Player.MenuCursor = 0;
		Event Player.ObjectIndex = 0;
		Call Subroutine(UpdateSelectObjAura);
		Call Subroutine(GetEditMenuTempData);
		Wait(0.2, Restart When True);
		Small Message(Event Player, Custom String("Page {0}: {1}", Event Player.MenuPage, Global.MenuOptionsNames[Event Player.MenuPage]));
	}
}
rule("EditMode: Press [Reload] + [Ability 2] to grab and move the selected object")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		"TODO: Only allow this for players with edit permissions"
		Global.EditMode == True;
		Is Button Held(Event Player, Button(Reload)) == True;
		Is Button Held(Event Player, Button(Ability 2)) == True;
	}
	actions
	{
		If(Event Player.ObjectSelectAura == Null);
			Small Message(Event Player, Custom String("No object selected"));
			Abort;
		End;
		If(Event Player.ObjectMoveGhost == Null);
			If(Distance Between(Position Of(Event Player), Event Player.ObjectSelectAura) > 16);
				Small Message(Event Player, Custom String("Selected object is too far to move"));
				Abort;
			End;
			If(True);
				Event Player.ObjectSelectAura[2] = Distance Between(Position Of(Event Player), Event Player.ObjectSelectAura[0]);
				
				Skip(Value In Array(Array(0,3,3,12,6,9,0), Event Player.MenuPage));
				Create Effect(Event Player, Ring, Color(Turquoise), Update Every Frame(Eye Position(Event Player) + Event Player.ObjectSelectAura[2] * Facing Direction Of(Event Player)), Event Player.ObjectSelectAura[1], Visible To Position Radius and Color);
				Event Player.ObjectMoveGhost = Append To Array(Event Player.ObjectMoveGhost, Last Created Entity);
				Skip(9);
				Event Player.ObjectMoveGhost = Append To Array(Event Player.ObjectMoveGhost, Last Created Entity);
				Create Effect(Event Player, Orb, Color(Turquoise), Update Every Frame(Eye Position(Event Player) + Event Player.ObjectSelectAura[2] * Facing Direction Of(Event Player)), Event Player.ObjectSelectAura[1], Visible To Position Radius and Color);
				Else;
				Create Effect(Event Player, Sphere, Event Player.MenuPage != 3 ? Color(Turquoise) : Color(Blue), Update Every Frame(Eye Position(Event Player) + 
				Event Player.ObjectSelectAura[2] * Facing Direction Of(Event Player)), Event Player.MenuPage != 3 ? Event Player.ObjectSelectAura[1] : 0.25, Visible To Position Radius and Color);
				Else;
				Create Effect(Event Player, Cloud, Color(Turquoise), Update Every Frame(Eye Position(Event Player) + Event Player.ObjectSelectAura[2] * Facing Direction Of(Event Player)), Event Player.ObjectSelectAura[1], Visible To Position Radius and Color);
				Event Player.ObjectMoveGhost = Append To Array(Event Player.ObjectMoveGhost, Last Created Entity);
				Create Effect(Event Player, Ring, Color(Turquoise), Update Every Frame(Eye Position(Event Player) + Event Player.ObjectSelectAura[2] * Facing Direction Of(Event Player)), Event Player.ObjectSelectAura[1], Visible To Position Radius and Color);
				Else;
				"Small orb for objects that require more precise placing"
				Create Effect(Event Player, Sphere, Color(Blue), Update Every Frame(Eye Position(Event Player) + 
				Event Player.ObjectSelectAura[2] * Facing Direction Of(Event Player)), 0.25, Visible To Position Radius and Color);
				Else;
			End;
			Event Player.ObjectMoveGhost = Append To Array(Event Player.ObjectMoveGhost, Last Created Entity);
			Play Effect(Event Player, Brigitte Repair Pack Impact Sound, Null, Position Of(Event Player), 100);
			Small Message(Event Player, Custom String("Holding {0}. Use {1}/{2} to move it farther/closer", Global.MenuOptionsNames[Event Player.MenuPage], Input Binding String(Button(Primary Fire)), Input Binding String(Button(Secondary Fire))));

		Else;
			Event Player.MenuCursor = 0;
			Event Player.ObjectSelectAura[2] = (Eye Position(Event Player) + 
				Event Player.ObjectSelectAura[2] * Facing Direction Of(Event Player));
			Call Subroutine(EditSelectedObject);
			Small Message(Event Player, Custom String("Moved object!"));
			Play Effect(Event Player, Buff Explosion Sound, Null, Event Player, 100);
			Destroy Effect(Event Player.ObjectMoveGhost);
			Event Player.ObjectMoveGhost = Null;
		End;
	}
}
rule("EditMode: Press [Primary/Secondary fire] while grabbing an object to adjust its position")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		"TODO: Only allow this for players with edit permissions"
		Global.EditMode == True;
		Event Player.ObjectMoveGhost != Null;
		Event Player.ObjectSelectAura != Null;
		(Is Button Held(Event Player, Button(Primary Fire)) != Is Button Held(Event Player, Button(Secondary Fire))) == True;
	}
	actions
	{
		Event Player.ObjectSelectAura[2] += Is Button Held(Event Player, Button(Primary Fire)) ? 0.1 : -0.1;
		
		If(Event Player.ObjectSelectAura[2] > 24);
			Event Player.ObjectSelectAura[2] = 24;
			Abort;
		Else If(Event Player.ObjectSelectAura[2] < (Distance Between(Eye Position(Event Player), Position Of(Event Player)) + Event Player.ObjectSelectAura[1]/2));
			Event Player.ObjectSelectAura[2] = Distance Between(Eye Position(Event Player), Position Of(Event Player)) + Event Player.ObjectSelectAura[1]/2;
			Abort;
		End;
		Wait(0.016, Ignore Condition);
		Loop If Condition Is True;
	}
}
rule("EditMode: Create Global Edit mode HUD")
{
	event
	{
		Ongoing - Global;
	}
	conditions
	{
		Global.EditMode == True;
	}
	actions
	{
		"Selected object indicator"
		disabled Create HUD Text(Local Player, Null, String Slice(Global.EnPadding, 0, 85), Custom String("Current Mode: {0}", Global.MenuOptionsNames[Local Player.MenuPage]),
			Left, 1, Null, Null, Color(Green), Visible To String And Color, Default Visibility);
		"Sidebar Buttons. TODO: hide buttons for players without edit mode permissions"
		Create HUD Text(All Players(All Teams), Null, 
			Custom String("\n\n{0}\n{1}", 
				Custom String("Insert {2}............ Interact + {0}\nDelete {2}............ Interact + {1}\nNext/Prev {2}.... Melee + {0}/{1}", 
					Input Binding String(Button(Primary Fire)),
					Input Binding String(Button(Secondary Fire)),
					Global.MenuOptionsNames[Local Player.MenuPage]
				), 
				Custom String("Open {0} menu... Interact 2x{1}", 
					Global.MenuOptionsNames[Local Player.MenuPage],
					String Slice(Global.EnPadding, 0, 85 - 26 - String Length(Global.MenuOptionsNames[Local Player.MenuPage]))
				)
			), 
			Null, Left, 10, Null, Color(Turquoise), Null, Visible To String And Color, Default Visibility);
		"Sidebar Buttons. TODO: hide buttons for players without edit mode permissions"
		Create HUD Text(All Players(All Teams), Null,
			Custom String("{0}\n{1}", 
			Custom String("Move {0}................ Reload + {1}\n{2}",
				Global.MenuOptionsNames[Local Player.MenuPage],
				Input Binding String(Button(Ability 2)),
				Custom String("Switch Mode: Interact + Melee + {0}/{1}", 
					Input Binding String(Button(Primary Fire)),
					Input Binding String(Button(Secondary Fire)))
			), 
			String Slice(Global.EnPadding, 0, 85)), 
			Null, Left, 11, Null, Color(Turquoise), Null, Visible To String And Color, Default Visibility);
		"Sidebar Buttons. TODO: hide buttons for players without edit mode permissions"
		disabled Create HUD Text(All Players(All Teams), Null, String Slice(Global.EnPadding, 0, 85),
			Custom String("Edit menu: Double click {0} \nSwitch Mode: {1} + {2}",
				Input Binding String(Button(Interact)),
				Input Binding String(Button(Ability 2)),
				Custom String("{0} + {1}/{2}", 
					Input Binding String(Button(Melee)),
					Input Binding String(Button(Primary Fire)), 
					Input Binding String(Button(Secondary Fire)))
			),
			Left, 12, Null, Null, Color(Purple), Visible To String And Color, Default Visibility);
		"TODO: Disable updating every frame if player is really going to be static, maybe hardcode coordinates"
		Create In-World Text(Local Player.MenuOpen ? Local Player : Null, 
			Custom String("--------------------------------------\n{0}{1}", 
				Global.MenuOptions[Local Player.MenuPage], 
				String Slice(
					Custom String("\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"), 
					0, 
					17 - Count Of(
						String Split(Global.MenuOptions[Local Player.MenuPage], 
						Custom String("\n"))
					)
				)
			), 
			Eye Position(Local Player) + 
			100 * (-0.5 * World Vector Of(Right, Local Player, Rotation) + 
			(-0.9) * Direction From Angles(
				Horizontal Angle From Direction(Facing Direction Of(Local Player)), 
				Vertical Angle From Direction(Facing Direction Of(Local Player)) - 90)
			+ 3 * Facing Direction Of(Local Player)), 
			2, Do Not Clip, Visible To Position String And Color, Color(White), Default Visibility);


		"View object data"
		Create In-World Text(Local Player.MenuOpen ? Local Player : Null, 
			Custom String("\n{0}{1}", Local Player.MenuTempData, 
				String Slice(
					Custom String("\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"), 
					0, 
					17 - Count Of(
						String Split(Local Player.MenuTempData, 
						Custom String("\n"))
					)
				)
			), 			
			Eye Position(Local Player) + 
			100 * (0.55 * World Vector Of(Right, Local Player, Rotation) + 
			(-0.9) * Direction From Angles(
				Horizontal Angle From Direction(Facing Direction Of(Local Player)), 
				Vertical Angle From Direction(Facing Direction Of(Local Player)) - 90)
			+ 3 * Facing Direction Of(Local Player)), 
			2, Do Not Clip, Visible To Position String And Color, Color(White), Default Visibility);
		
		"Menu cursor"
		Create In-World Text(Local Player.MenuOpen ? Local Player : Null, 
			Custom String("\n{0}{1}{2}", 
				String Slice(
					Custom String("\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"), 
					0, 
					Local Player.MenuCursor),
				Icon String(Arrow: Right),
				String Slice(
					Custom String("\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"), 
					0, 
					16 - Local Player.MenuCursor
				)
			), 
			Eye Position(Local Player) + 
			100 * (-1.4 * World Vector Of(Right, Local Player, Rotation) + 
			(-0.9) * Direction From Angles(
				Horizontal Angle From Direction(Facing Direction Of(Local Player)), 
				Vertical Angle From Direction(Facing Direction Of(Local Player)) - 90)
			+ 3 * Facing Direction Of(Local Player)), 
			2, Do Not Clip, Visible To Position String And Color, Color(White), Default Visibility);

		"Create highlighted object aura"
		Create Effect(Local Player.ObjectSelectAura ? Local Player : Null, Good Aura, Color(Green), Local Player.ObjectSelectAura[0], Local Player.ObjectSelectAura[1], Visible To Position Radius and Color);
		Create Icon(Local Player.ObjectSelectAura ? Local Player : Null, Local Player.ObjectSelectAura[0] + Vector(0, Local Player.ObjectSelectAura[1], 0), Arrow: Down, Visible To and Position, Color(Green), True);
	}
}
rule("EditMode: Subroutine GetEditMenuTempData")
{
	event
	{
		Subroutine;
		GetEditMenuTempData;
	}

	actions
	{
		Event Player.MenuTempData = Empty Array;
		For Player Variable(Event Player, i, 0, Value In Array(Array(8, 2, 6, 6, 2, 3, 5), Event Player.MenuPage), 1);
			Skip(Event Player.MenuPage * 2);
			Event Player.MenuTempData = Custom String("{0}{1}\n", Event Player.MenuTempData, Global.Checkpoints[Event Player.Checkpoint][Event Player.i]);
		Continue;
			Event Player.MenuTempData = Custom String("{0}{1}\n", Event Player.MenuTempData, Global.Orbs[Event Player.Checkpoint][Event Player.ObjectIndex][Event Player.i]);
		Continue;
			Event Player.MenuTempData = Custom String("{0}{1}\n", Event Player.MenuTempData, Global.RefreshOrbs[Event Player.Checkpoint][Event Player.ObjectIndex][Event Player.i]);
		Continue;
			Event Player.MenuTempData = Custom String("{0}{1}\n", Event Player.MenuTempData, Global.Bots[Event Player.Checkpoint][Event Player.ObjectIndex][Event Player.i]);
		Continue;
			Event Player.MenuTempData = Custom String("{0}{1}\n", Event Player.MenuTempData, Global.AntiOrbs[Event Player.Checkpoint][Event Player.ObjectIndex][Event Player.i]);
		Continue;
			Event Player.MenuTempData = Custom String("{0}{1}\n", Event Player.MenuTempData, Global.Clouds[Event Player.Checkpoint][Event Player.ObjectIndex][Event Player.i]);
		Continue;	
			Event Player.MenuTempData = Custom String("{0}{1}\n", Event Player.MenuTempData, Global.Teleports[Event Player.Checkpoint][Event Player.i]);
		End;	
	}
}
rule("EditMode: Subroutine CreatePlayerEditModeHUD")
{
	event
	{
		Subroutine;
		CreatePlayerEditModeHUD;
	}

	actions
	{

		Create In-World Text(Event Player,
		Custom String("Coordinates: {0}\nRadius: {1}\n{2}", Global.Checkpoints[Event Player.Checkpoint][0], Global.Checkpoints[Event Player.Checkpoint][1], 
			Custom String("Facing Direction: {0}\nCrouch: {1}\n{2}", 
				Global.Checkpoints[Event Player.Checkpoint][2], 
				Global.Checkpoints[Event Player.Checkpoint][3], 
				Custom String("Require Ground: {0}\n{1}\nUnlimited GA: {2}", 
					Global.Checkpoints[Event Player.Checkpoint][4],
					Custom String("Threshold Above/Below: {0}/{1}\nDistance: {2}",
						Global.Checkpoints[Event Player.Checkpoint][5], 
						Global.Checkpoints[Event Player.Checkpoint][6], 
						Distance Between(Event Player, Global.Checkpoints[Event Player.Checkpoint][0])
					),
					Global.Checkpoints[Event Player.Checkpoint][7]
				)
			)
		),
		Global.Checkpoints[Event Player.Checkpoint][0],
		1, 
		Do Not Clip,
		Visible To Position and String,
		Color(Green),
		Default Visibility
		);
		"Create Bot text"
		Create In-World Text(Global.Bots[Event Player.Checkpoint] ? Event Player : Null,
		Custom String("{0}\nFacing: {1}\n{2}", 
			Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][0], 
			Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][1] ? Custom String("Player") : Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][1], 
			Custom String("Crouch: {0}\nGravity: {1}\n{2}", 
				Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][2],
				Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][3], 
				Custom String("Resurrect: {0}\nRefresh GA after Rez: {1}\nCurrentPos: {2}", 
					Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][4],
					Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][5],
					Position Of(Event Player.Bot)
				)
			)
		),
		Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][0] + Vector(0,1,0),
		1, 
		Do Not Clip,
		Visible To Position and String,
		Color(Aqua),
		Default Visibility
		);
		"Debug landing threshold and goal condition"
		Create Hud Text(Event Player, Null, Null, Custom String("X: {0}, Y: {1}, Z: {2}",
		X Component Of(Position Of(Event Player)),
		Y Component Of(Position Of(Event Player)),
		Z Component Of(Position Of(Event Player))),
		Top, 0, Null, Null, Color(White), String, Default Visibility);
		
	}
}
rule("Subroutine SetEditModeObjectIndex")
{
	event
	{
		Subroutine;
		SetEditModeObjectIndex;
	}

	actions
	{
		If(True);
			Skip(Event Player.MenuPage * 2);
			Event Player.ObjectSelectTemp = Count Of(Global.Checkpoints);
			Else;
			Event Player.ObjectSelectTemp = Count Of(Global.Orbs[Event Player.Checkpoint]);
			Else;
			Event Player.ObjectSelectTemp = Count Of(Global.RefreshOrbs[Event Player.Checkpoint]);
			Else;
			Event Player.ObjectSelectTemp = Count Of(Global.Bots[Event Player.Checkpoint]);
			Else;
			Event Player.ObjectSelectTemp = Count Of(Global.AntiOrbs[Event Player.Checkpoint]);
			Else;
			Event Player.ObjectSelectTemp = Count Of(Global.Clouds[Event Player.Checkpoint]);
			Else;
			"TODO: Multiple teleports not supported yet, update this when they are"
			Event Player.ObjectSelectTemp = Global.Teleports[Event Player.Checkpoint] != False ? 1 : 0;
			Else;
		End;
		
		Event Player.ObjectIndex = (Event Player.ObjectIndex + Event Player.ObjectSelectTemp) % Event Player.ObjectSelectTemp;
		If(Event Player.MenuPage == 0);
			Event Player.TempFreeMode = Event Player.FreeMode;
			Event Player.FreeMode = True;
			Event Player.Checkpoint = Event Player.ObjectIndex;
		End;
		Call Subroutine(UpdateSelectObjAura);
	}
}
rule("Subroutine UpdateSelectObjAura")
{
	event
	{
		Subroutine;
		UpdateSelectObjAura;
	}

	actions
	{
		If(True);
			Skip(Event Player.MenuPage * 2);
			Event Player.ObjectSelectAura = Global.Checkpoints[Event Player.Checkpoint] != Null ? Array Slice(Global.Checkpoints[Event Player.Checkpoint], 0 , 2) : Null;
			Else;
			Event Player.ObjectSelectAura = Global.Orbs[Event Player.Checkpoint][Event Player.ObjectIndex] != Null ? Array Slice(Global.Orbs[Event Player.Checkpoint][Event Player.ObjectIndex], 0, 2) : Null;
			Else;
			Event Player.ObjectSelectAura = Global.RefreshOrbs[Event Player.Checkpoint][Event Player.ObjectIndex] != Null ? Array Slice(Global.RefreshOrbs[Event Player.Checkpoint][Event Player.ObjectIndex], 0, 2) : Null;
			Else;
			Event Player.ObjectSelectAura = Global.Bots[Event Player.Checkpoint][Event Player.ObjectIndex] != Null ? Array(Global.Bots[Event Player.Checkpoint][Event Player.ObjectIndex][0], 1.7) : Null;
			Else;
			Event Player.ObjectSelectAura = Global.AntiOrbs[Event Player.Checkpoint][Event Player.ObjectIndex] != Null ? Array Slice(Global.AntiOrbs[Event Player.Checkpoint][Event Player.ObjectIndex], 0, 2) : Null;
			Else;
			Event Player.ObjectSelectAura = Global.Clouds[Event Player.Checkpoint][Event Player.ObjectIndex] != Null ? Array Slice(Global.Clouds[Event Player.Checkpoint][Event Player.ObjectIndex], 0, 2) : Null;
			Else;
			Event Player.ObjectSelectAura = Global.Teleports[Event Player.Checkpoint] != Null ? Array Slice(Global.Teleports[Event Player.Checkpoint][Event Player.ObjectIndex], 0, 2) : Null;
			Else;
		End;
	}
}
rule("Subroutine EditSelectedObject")
{
	event
	{
		Subroutine;
		EditSelectedObject;
	}

	actions
	{
		"Get current level object array"
		If(True);
			Skip(Event Player.MenuPage * 2);
			Event Player.EditTempArray = Global.Checkpoints[Event Player.Checkpoint];
			Else;
			Event Player.EditTempArray = Global.Orbs[Event Player.Checkpoint];
			Else;
			Event Player.EditTempArray = Global.RefreshOrbs[Event Player.Checkpoint];
			Else;
			Event Player.EditTempArray = Global.Bots[Event Player.Checkpoint];
			Else;
			Event Player.EditTempArray = Global.AntiOrbs[Event Player.Checkpoint];
			Else;
			Event Player.EditTempArray = Global.Clouds[Event Player.Checkpoint];
			Else;
			Event Player.EditTempArray = Global.Teleports[Event Player.Checkpoint];
			Else;
		End;
		"Checkpoints and teleports are not encapsulated in other arrays"
		If(Event Player.MenuPage == 0 || Event Player.MenuPage == 6);
			Event Player.EditTempObject = Event Player.EditTempArray;
		Else;
			"Single out the edited object"
			Event Player.EditTempObject = Event Player.EditTempArray[Event Player.ObjectIndex];
		End;

		"TODO: Temporary, only valid when using hold and move"
		If(Event Player.MenuCursor == 0);
			Event Player.EditTempObject[0] = Event Player.ObjectSelectAura[2];
			Event Player.ObjectSelectAura[0] = Event Player.ObjectSelectAura[2];

		"TODO: Validate different language clients"
		Else If(String Contains(Custom String("{0} {1}", True, False), Custom String("{0}", Event Player.EditTempObject[Event Player.MenuCursor])));
			Event Player.EditTempObject[Event Player.MenuCursor] = !Event Player.EditTempObject[Event Player.MenuCursor];
		Else;
			Play Effect(Event Player, Debuff Impact Sound, Null, Event Player, 100);
			Small Message(Event Player, Custom String("The value you tried to edit is not supported yet"));
			Abort;
		End;
		"Pack the array again"
		If(Event Player.MenuPage == 0 || Event Player.MenuPage == 6);
			Event Player.EditTempArray = Event Player.EditTempObject;
		Else;
			Event Player.EditTempArray[Event Player.ObjectIndex] = Event Player.EditTempObject;
		End;

		Wait(0.016, Ignore Condition);
		"Save data"
		If(True);
			Skip(Event Player.MenuPage * 2);
			Global.Checkpoints[Event Player.Checkpoint] = Event Player.EditTempArray;
			Else;
			Global.Orbs[Event Player.Checkpoint] = Event Player.EditTempArray;
			Else;
			Global.RefreshOrbs[Event Player.Checkpoint] = Event Player.EditTempArray;
			Else;
			Global.Bots[Event Player.Checkpoint] = Event Player.EditTempArray;
			Else;
			Global.AntiOrbs[Event Player.Checkpoint] = Event Player.EditTempArray;
			Else;
			Global.Clouds[Event Player.Checkpoint] = Event Player.EditTempArray;
			Else;
			Global.Teleports[Event Player.Checkpoint] = Event Player.EditTempArray;
			Else;
		End;
		
		If(Event Player.MenuPage == 3);
			"Call for a bot update"
			Set Player Variable(Event Player.Bot, BotUpdate, True);
		End;
		Play Effect(Event Player, Buff Impact Sound, Null, Event Player, 100);
	}
}
rule("——————————————————————————Subroutines——————————————————————————")
{
	event
	{
		Ongoing - Global;
	}
}
rule("Subroutine InitializeGlobalVariables")
{
	event
	{
		Subroutine;
		InitializeGlobalVariables;
	}

	actions
	{
		Global.DebugMode = Workshop Setting Toggle(Custom String("Giga editor options"), Custom String("Debug Mode (Inspector Recording)"), False, 0);
		Global.EditMode = Workshop Setting Toggle(Custom String("Giga editor options"), Custom String("Edit Mode"), False, 0);		
		Global.ServerLoad = Workshop Setting Toggle(Custom String("Giga editor options"), Custom String("Server Load Widget"), False, 0);	
		Global.OrbStyle = Workshop Setting Combo(Custom String("Effects Options"), Custom String("Orb Style"), 0, Array(Custom String("Auto"), Custom String("Orb"), Custom String("Sphere")), 0);	
		Global.RefreshOrbStyle = Workshop Setting Combo(Custom String("Effects Options"), Custom String("Refresh Orb Style"), 0, Array(Custom String("Auto"), Custom String("Orb"), Custom String("Sphere"), Custom String("Cloud & Sparkles")), 0);	

		Call Subroutine(CreateGlobalHUD);
		Global.Checkpoints = Empty Array;
		Global.Bots = Empty Array;
		Global.Orbs = Empty Array;
		Global.AntiOrbs = Empty Array;
		Global.RefreshOrbs = Empty Array;
		Global.Teleports = Empty Array;
		Global.RGB = Array(255,0,0);
		Global.Scoreboard = Empty Array;
		Global.EnPadding = Custom String("                                                                                                                                ");
		Global.PlayerData = Empty Array;
		Global.ShowSidebarControlsPlayers = Empty Array;
	}
}
rule("Subroutine InitializePlayerVariables")
{
	event
	{
		Subroutine;
		InitializePlayerVariables;
	}

	actions
	{
		Event Player.Checkpoint = 0;
		Event Player.Finished = False;
		Event Player.FreeMode = False; 
		Event Player.ThirdPerson = False;
		Event Player.CurrentRunTime = 0;
		Event Player.Mistakes = 0;
		Event Player.OrbEffects = Empty Array;
		Event Player.OrbIcons = Empty Array;
		Event Player.RefreshOrbEffects = Empty Array;
		Event Player.RefreshOrbIcons = Empty Array;
		Event Player.CloudEffects = Empty Array;
		Event Player.AntiOrbEffects = Empty Array;
		Event Player.BotEffects = Empty Array;
		Event Player.BotIcons = Empty Array;
		Event Player.Scale = 1;
		Event Player.SpectatorMode = False;
		Event Player.Collision = True;
		"// TODO: Cleanup, maybe not needed"
		Event Player.CurrentBotSection = 0;
		"// TODO: Get rid of this temp variable?"
		Event Player.Temp = First Of(Filtered Array(Global.VIPs, Current Array Element[0] == Custom String("{0}", Event Player)));
		If(Count Of(Event Player.Temp) > 1);
			Event Player.PlayerName = Event Player.Temp[1];
			Event Player.PlayerNameColor = Event Player.Temp[2];
		Else;
			Event Player.PlayerName = Custom String("{0}", Event Player);
			Event Player.PlayerNameColor = Global.Settings[14];
		End;
		Event Player.Temp = First Of(Filtered Array(Global.PlayerData, Current Array Element[0] == Custom String("{0}", Event Player)));
		If(Count Of(Event Player.Temp) > 1);
			Event Player.Finished = Event Player.Temp[1];
			Event Player.Checkpoint = Event Player.Temp[2];
			Event Player.CurrentRunTime = Event Player.Temp[3];
			Event Player.Mistakes = Event Player.Temp[4];
			Modify Global Variable(PlayerData, Remove From Array By Index, Index Of Array Value(Global.PlayerData, Event Player.Temp));
			Small Message(Event Player, Custom String("Welcome Back, {0}", Event Player));
		End;
		If(Global.EditMode);
			Event Player.NewObjectDefaults = Array(
				Array(Null, 1.6, False, True, False, 1.6, 1.6, False),
				Array(Null, 0.8),
				Array(Null, 0.8, False, True, False, False),
				Array(Null, False, False, False, False, True),
				Array(Null, 2),
				Array(Null, 1, 8),
				Array(Null, 1.6, False, 1.6, 1.6)
			);
		End;
	}
}
rule("Subroutine InitializePlayerBot")
{
	event
	{
		Subroutine;
		InitializePlayerBot;
	}

	actions
	{
		If(!Event Player.Bot);
			Create Dummy Bot(Global.Settings[10], 
			Team Of(Event Player), 
			Slot Of(Event Player) + Number Of Slots(All Teams),
			Nearest Walkable Position(Global.BotPenCoords),
			Null);
			Event Player.Bot = Last Created Entity;
			Disable Built-In Game Mode Respawning(Event Player.Bot);
			Set Player Variable(Event Player.Bot, Checkpoint, Event Player.Checkpoint);
			Set Player Variable(Event Player.Bot, CurrentBotSection, Event Player.CurrentBotSection);
			Set Player Variable(Event Player.Bot, Scale, 1);

			Set Gravity(Event Player.Bot, 0);
			Set Status(Event Player.Bot, Null, Invincible, 9999);
			Set Status(Event Player.Bot, Null, Phased Out, 9999);
			Start Forcing Dummy Bot Name(Event Player.Bot, Custom String("{0}'s {1}", Event Player, Global.Settings[10]));
			"// TODO: Temporarily moved here, move back when bot facing direction can be enabled per level"
			Start Facing(Event Player.Bot, 
				Direction Towards(
					Update Every Frame(Eye Position(Event Player.Bot)), 
					Update Every Frame(Eye Position(Event Player))), 
				9999, To World, Direction and Turn Rate);
		End;
	}
}
rule("Subroutine UpdateBotPosition")
{
	event
	{
		Subroutine;
		UpdateBotPosition;
	}

	actions
	{
		"Call for a bot update"
		Set Player Variable(Event Player.Bot, BotUpdate, True);
		Wait(0.016, Ignore Condition);
		"// TODO: See if we can move this to Update Bot Status rule, so far we cant keep a reference to real player"
		If(Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection]);
			Start Forcing Player Outlines(
				Event Player.Bot,
				Event Player,
				True,
				Global.Checkpoints[Event Player.Checkpoint][3] ? Global.Settings[20] : Global.Settings[19], Always);
		Else;
			Stop Forcing Player Outlines(Event Player.Bot, Event Player);
			"// TODO: Possibly deprecated when we added the root effect on teleport, still need to find a way to disable ghost ga tho"
			disabled If(Hero Of(Event Player) == Hero(Mercy));
				disabled Cancel Primary Action(Event Player);
			disabled End;
		End;

		"// TODO: Idk use bot rewards or something, this is bad"	
		If(Hero Of(Event Player) == Hero(Mercy));
			Event Player.Ability2 = Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][4];
			Set Ability 2 Enabled(Event Player, Event Player.Ability2);
		End;

		"Bot Condition checks if we need to rez the current bot. False = Requires rez, True = Alles gut"
		Event Player.BotCondition = !Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][4];
	}
}
rule("Subroutine DecompressMapData")
{
	event
	{
		Subroutine;
		DecompressMapData;
	}
}
rule("Subroutine CreateGlobalHUD")
{
	event
	{
		Subroutine;
		CreateGlobalHUD;
	}

	actions
	{
		"Map Creator and code"
		Create HUD Text(All Players(All Teams), Null, String Slice(Global.EnPadding, 0, 85), Custom String("{0}{1}", Global.MapTitle, Global.EditMode == False ? Custom String("\n\n") : Empty Array),
		Left, 0, Null, Color(Red), Global.Settings[18] != Null ? Global.Settings[18] : Custom Color(Global.RGB[0], Global.RGB[1], Global.RGB[2], 255), Visible To String and Color, Default Visibility);
		
			
		"Scoreboard Title"
		Create HUD Text(Count Of(Global.Scoreboard) > 0 ? All Players(All Teams) : Null, 
		Null, 
		String Slice(Global.EnPadding, 0, 85),
		Global.Settings[17],
		Left, 2, Null, Null, Global.Settings[15], Visible To String and Color, Default Visibility);
		
		"Top 5 scoreboard rows"
		For Global Variable(i, 0, 5, 1);
			"Insert scoreboard record"
			Create HUD Text(Count Of(Global.Scoreboard[Evaluate Once(Global.i)]) > 0 ? All Players(All Teams) : Null,  
				Hero Icon String(
					Global.Scoreboard[Evaluate Once(Global.i)][3]), 
			Custom String("{0} {1}\n{2}", 
			Global.Top5Prefix[Evaluate Once(Global.i)],
			Global.Scoreboard[Evaluate Once(Global.i)][0],
			Custom String("{0} sec - Mistakes: {1}{2}", 
				Global.Scoreboard[Evaluate Once(Global.i)][1],
				Global.Scoreboard[Evaluate Once(Global.i)][2],
				String Slice(
					Global.EnPadding, 0, 85 - 21 - String Length(Custom String("{0}{1}",
						Global.Scoreboard[Evaluate Once(Global.i)][1],
						Global.Scoreboard[Evaluate Once(Global.i)][2])
					)
				)
			)
			),
			Null,
			Left, 3 + Global.i, Global.Top5Colors[Evaluate Once(Global.i)], Global.Top5Colors[Evaluate Once(Global.i)], Null, Visible To and String, Default Visibility);
		End;

		"Instructions"
		Create HUD Text(All Players(All Teams), Null, Custom String("Double click {0} to show or hide controls", Input Binding String(Button(Interact))), Null,
			Right, 11, Null, Custom Color(192, 192, 192, 255), Null, Visible To and String, Default Visibility);

		"// TODO: Break up into blocks that use no more than 4 input binding string per custom string"
		disabled End;

		"Controls pt1"
		Create HUD Text(Global.EditMode ? All Players(All Teams) : Global.ShowSidebarControlsPlayers, Null, Null,
			Custom String("— — — — — — — — — — — — — — —\n{0}\n{1}",
				Custom String("Reset level: {0}", 
					Input Binding String(Button(Reload))
				),
				Custom String("Start over: {0} + {1} + {2}", 
					String Length(Input Binding String(Button(Crouch))) > 0 ? Input Binding String(Button(Crouch)) : Custom String("[Crouch]"), 
					Input Binding String(Button(Interact)),
					Input Binding String(Button(Ability 2))
				)
			), 
		Right, 12, Null,  Null, Color(White), Visible To and String, Default Visibility);
		
		Skip If(Global.EditMode, 1);
		"Controls pt2. Lord forgive me for this hack"
		Create HUD Text(Global.EditMode ? All Players(All Teams) : Global.ShowSidebarControlsPlayers, Null, Null,
			Custom String("Switch Level: {0} + {1} + {2}", 
				Input Binding String(Button(Ability 2)), 
				Input Binding String(Button(Melee)), 
				Custom String("{0}/{1}{2}", 
					Input Binding String(Button(Primary Fire)), 
					Input Binding String(Button(Secondary Fire)),
					 Is True For Any(
			Array(
				Button(Ability 1), 
				Button(Ability 2), 
				Button(Crouch), 
				Button(Interact), 
				Button(Jump), 
				Button(Melee), 
				Button(Primary Fire), 
				Button(Reload), 
				Button(Secondary Fire), 
				Button(Ultimate)), 
			First Of(
				Input Binding String(Current Array Element)) && 
				String Contains(
					Custom String("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789&~\"#'{([-|`_\\^@)]=}^$%*,?.;/:>²ÉÈÇÀÙ+¤^ßÜÖÄÑ¡´¿ÒÌСЛП↓←→↑스아좌왼숫우오위空回退大下左暂右上；，向數"),
					Char In String(Input Binding String(Current Array Element), 0))) ? Custom String("    ") : Custom String(" ")
				)
			),
		Right, 13, Null, Null, Color(White),  Visible To and String, Default Visibility);
		
		"Controls pt3"
		Create HUD Text(Global.EditMode ? All Players(All Teams) : Global.ShowSidebarControlsPlayers, Null, Null,
			Custom String("Free Mode: {0} + {1} + {2}  ", 
				String Length(Input Binding String(Button(Crouch))) > 0 ? Input Binding String(Button(Crouch)) : Custom String("[Crouch]"), 
				Input Binding String(Button(Reload)),
				Custom String("{0}{1}", Input Binding String(Button(Melee)), String Length(Input Binding String(Button(Crouch))) < 4 ? Custom String("  ") : Empty Array)
			),
		Right, 14, Null, Null, Color(White), Visible To and String, Default Visibility);
		
		"Controls pt4"
		Create HUD Text(Global.EditMode ? All Players(All Teams) : Global.ShowSidebarControlsPlayers, Null, Null,
			Custom String("{0}\n{1}\n— — — — — — — — — — — — — — —",
				Custom String("3rd Person: {0} + {1}", 
					Input Binding String(Button(Jump)), 
					Input Binding String(Button(Reload)) 
				),
				Custom String("Spectate: {0} + {1}", 
					Input Binding String(Button(Ultimate)), 
					Input Binding String(Button(Ability 2))
				)
			),
		Right, 15, Null,  Null, Color(White), Visible To and String, Default Visibility);
		
		"// TODO: Move to player init and use preferred language"
		Create HUD Text(All Players(All Teams), Null, 
		Custom String("Elapsed time: {0} minutes {1} seconds",
		Round To Integer(Total Time Elapsed / 60, Down), Round To Integer(Total Time Elapsed % 60, Down)),
		Null,
		Top,
		0, Null, Color(White), Null, Visible To and String, Default Visibility);
	}
}
rule("Subroutine CreatePlayerHUD")
{
	event
	{
		Subroutine;
		CreatePlayerHUD;
	}

	actions
	{
		"Top HUD Elements"
		Create HUD Text(Event Player, Null, Custom String("Level: {0}/{1}", Event Player.Checkpoint, Count Of(Global.Checkpoints) - 1), Null, 
			Top, 1, Null, Color(White), Null, Visible To and String, Default Visibility);
		Create HUD Text(
			Event Player, 
			Null,
			Count Of(Event Player.GrabbedOrbs) > 0 || Count Of(Event Player.GrabbedRefreshOrbs) > 0 ? Custom String("Collected Orbs:\n{0}{1}", 
				Count Of(Event Player.GrabbedOrbs) > 0 ? Custom String("{0}: {1}/{2}  ", Icon String(Halo), Count Of(Filtered Array(Event Player.GrabbedOrbs, Current Array Element == True)), Count Of(Event Player.GrabbedOrbs)) : Empty Array,
				Count Of(Event Player.GrabbedRefreshOrbs) > 0 ? Custom String("  {0}: {1}/{2}", Icon String(Recycle), Count Of(Filtered Array(Event Player.GrabbedRefreshOrbs, Current Array Element == True)),
		Count Of(Event Player.GrabbedRefreshOrbs)) : Empty Array) : Custom String("\n"),
			Null,
			Top, 2, Null, Custom Color(Global.RGB[0], Global.RGB[1], Global.RGB[2], 255), Null, Visible To String and Color, Default Visibility);
		"Right HUD Elements"
		Create HUD Text(Event Player, Null, Null, Custom String("Time: {0} sec\nMistakes: {1}\n", Event Player.CurrentRunTime, Event Player.Mistakes), 
			Right, 0, Null, Null, Color(White),  Visible To and String, Default Visibility);
		
		"Create player name tag"
			Create In-World Text(All Players(All Teams), Custom String("{0} {1}{2}", Event Player.PlayerName, Event Player.Checkpoint, Event Player.Cheat ? Custom String("({0})", Event Player.SavedCheckpoint) : Empty Array), Event Player, 1.300, Do Not Clip, Visible To Position String And Color, Event Player.PlayerNameColor, Default Visibility);
	}
}
rule("Subroutine SetUpCheckpoint")
{
	event
	{
		Subroutine;
		SetUpCheckpoint;
	}

	actions
	{
		Log To Inspector(Custom String("{0} - SetUpCheckpoint {1}", Event Player, Event Player.Checkpoint));
		Event Player.Finished = Event Player.Checkpoint == Count Of(Global.Checkpoints) - 1;

		Event Player.GoalCoords = Global.Teleports[Event Player.Checkpoint] ? Global.Teleports[Event Player.Checkpoint][0] : Global.Checkpoints[Event Player.Checkpoint + 1][0];
		Event Player.GoalRadius = Global.Teleports[Event Player.Checkpoint] ? Global.Teleports[Event Player.Checkpoint][1] : Global.Checkpoints[Event Player.Checkpoint + 1][1];
		Event Player.GoalThresholds = Array(Global.Checkpoints[Event Player.Checkpoint + 1][5], Global.Checkpoints[Event Player.Checkpoint + 1][6]);
		
		"Set facing direction"
		If(Global.Checkpoints[Event Player.Checkpoint][2]);
			"TODO FIXME: Added this to see if face direction bug is fixed or not"
			Wait(0.016, Ignore Condition);
			Set Facing(Event Player, Global.Checkpoints[Event Player.Checkpoint][2], To World);
			If(Global.DebugMode == True);
				Small Message(Event Player, Custom String("Set facing to {0}", Global.Checkpoints[Event Player.Checkpoint][2]));
			End;
		End;
		If(Event Player.Checkpoint == 0);
			Stop Chasing Player Variable(Event Player, CurrentRunTime);
			Event Player.CurrentRunTime = 0;
		End;
		"// TODO: Refactor to use compressed abilities"
		Event Player.StartingAbilities = 
			Array(
				Global.Checkpoints[Event Player.Checkpoint][3],
				True,
				Global.Bots[Event Player.Checkpoint] ? True : False,
				False,
				False,
				True,
				True,
				True
			);
		
		"// TODO: Enable abilities for non mercy heroes"
		If(Hero Of(Event Player) != Hero(Mercy));
			Event Player.StartingAbilities[2] = True;
		End;

		"Set Bot checkpoint too"
		Set Player Variable(Event Player.Bot, Checkpoint, Event Player.Checkpoint);
		Call Subroutine(CreateCurrentWorldTexts);
		Call Subroutine(ResetCheckpoint);

		If(Global.BigMessages[Event Player.Checkpoint] != False);
			"Display current level Big message"
			Big Message(Event Player, Global.BigMessages[Event Player.Checkpoint]);
		End;
		"// TODO: Consider removing small messages as they are hard to notice"
		If(Global.SmallMessages[Event Player.Checkpoint] != False);
			"Display current level Big message"
			Small Message(Event Player, Global.SmallMessages[Event Player.Checkpoint]);
		End;
	}
}
rule("Subroutine ResetWithMistake")
{
	event
	{
		Subroutine;
		ResetWithMistake;
	}

	actions
	{
		Log To Inspector(Custom String("{0} - Reset with mistake", Event Player));
		"// TODO: Toggle this if you want glitch levels like in taws or peace"
		Cancel Primary Action(Event Player);
		Event Player.Mistakes = Event Player.Checkpoint == 0 ? 0 : Event Player.Mistakes + 1;
		Call Subroutine(TeleportToCurrentCheckpoint);
		Call Subroutine(ResetCheckpoint);
	}
}
rule("Subroutine ResetCheckpoint")
{
	event
	{
		Subroutine;
		ResetCheckpoint;
	}

	actions
	{
		Event Player.Resetting = True;
		Log To Inspector(Custom String("{0} - Reset Checkpoint", Event Player));
		
		If(Event Player.Checkpoint == 0);
			Stop Chasing Player Variable(Event Player, CurrentRunTime);
			Event Player.CurrentRunTime = 0;
		End;

		"Reset all orbs to not grabbed"
		Event Player.GrabbedOrbs = Count Of(Global.Orbs[Event Player.Checkpoint]) > 0 ? Mapped Array(Global.Orbs[Event Player.Checkpoint], False) : Empty Array;
		Event Player.GrabbedRefreshOrbs = Count Of(Global.RefreshOrbs[Event Player.Checkpoint]) > 0 ? Mapped Array(Global.RefreshOrbs[Event Player.Checkpoint], False) : Empty Array;
		Event Player.LeftCheckpoint = False;	
		Event Player.CurrentBotSection = 0;
		Set Player Variable(Event Player.Bot, CurrentBotSection, 0);

		Event Player.Crouch = Event Player.StartingAbilities[0];
		Event Player.Jump = Event Player.StartingAbilities[1];
		Event Player.Ability1 = Event Player.StartingAbilities[2];
		Event Player.Ability2 = Event Player.StartingAbilities[3];
		Event Player.Ultimate = Event Player.StartingAbilities[4];
		"// TODO: Temporarily enabled here, should come from cp flags"
		Call Subroutine(SetCurrentAbilities);
		Call Subroutine(UpdateBotPosition);
		Event Player.Resetting = False;
	}
}
rule("Subroutine TeleportToCurrentCheckpoint")
{
	event
	{
		Subroutine;
		TeleportToCurrentCheckpoint;
	}

	actions
	{
		Log To Inspector(Custom String("{0} - Teleport Player", Event Player));
		Set Status(Event Player, Null, Rooted, 0.2);
		Call Subroutine(CancelMomentum);
		Teleport(Event Player, Global.Checkpoints[Event Player.Checkpoint][0]);
	}
}
rule("Subroutine CreatePlayerDebugModeHUD")
{
	event
	{
		Subroutine;
		CreatePlayerDebugModeHUD;
	}

	actions
	{
		"Ability 1 related info"
		Create HUD Text(Event Player, Null, Null, Custom String("‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ \nVar Ability1: {0}\nAbility 1 CD: {1}\nIsUsingAbility1: {2}", 
		Event Player.Ability1, 
		Ability Cooldown(Event Player, Button(Ability 1)), 
		Custom String("{0}\nAbility Charge: {1}", 
			Is Using Ability 1(Event Player) || False,
			Ability Charge(Event Player, Button(Ability 1)))
		), 
		Right, 99, Null, Null, 
		Color(Orange), Visible To String and Color, Default Visibility);
		
		"Ability 2 related info"
		Create HUD Text(Event Player, Null, Null, Custom String("‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ \nVar Ability2: {0}\nAbility 2 CD: {1}\nIsUsingAbility2: {2}", 
		Event Player.Ability2, 
		Ability Cooldown(Event Player, Button(Ability 2)), 
		Custom String("{0}\nAbility Charge: {1}", 
			Is Using Ability 2(Event Player) || False,
			Ability Charge(Event Player, Button(Ability 2)))
		), 
		Right, 100, Null, Null, 
		Color(Aqua), Visible To String and Color, Default Visibility);

		"Bunnyhop related info"
		Create HUD Text(Event Player, Null, Null, Custom String("‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ \nIs On Ground: {0}\nIs In Air: {1}\nIs Crouching: {2}", 
		Is On Ground(Event Player), 
		Is In Air(Event Player), 
		Custom String("{0}\nIs Jumping: {1}\nBHop ready?: {2}", 
			Is Crouching(Event Player),
			Is Jumping(Event Player),
			Event Player.BhopReady)
		), 
		Right, 101, Null, Null, 
		Color(Blue), Visible To String and Color, Default Visibility);

		"Checkpoint landing debug"
		Create HUD Text(Event Player, Null, Null, Custom String("‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ \nDistance to Goal: {0}\nPlayer Y: {1}\nGoal Y: {2}", 
		Distance Between(Event Player, Event Player.GoalCoords), 
		Y Component Of(Position Of(Event Player)), 
		Y Component Of(Event Player.GoalCoords)), 
		Right, 102, Null, Null, 
		(Distance Between(Event Player, Event Player.GoalCoords) <= Event Player.GoalRadius && 
			((Y Component Of(Position Of(Event Player)) <= (Y Component Of(Event Player.GoalCoords) + Event Player.GoalThresholds[0])) &&
			(Y Component Of(Position Of(Event Player)) >= (Y Component Of(Event Player.GoalCoords) - Event Player.GoalThresholds[1])))) 
		? Color(Green) : Color(Red), Visible To String and Color, Default Visibility);
		
		"Throttle debug"
		Create Hud Text(Event Player, Null, Null, Custom String("‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ ‒ \nThrottle: {0}", Throttle Of(Event Player)),  Right, 103, Color(White), Color(White), Color(White), Visible To And String, Default Visibility);
	}
}
rule("Subroutine CancelMomentum")
{
	event
	{
		Subroutine;
		CancelMomentum;
	}

	actions
	{
		Log To Inspector(Custom String("{0} - Cancelled Momentum", Event Player));
		Apply Impulse(Event Player, Up, 0, To World, Cancel Contrary Motion XYZ);
		Wait(0.016, Restart When True);
		Apply Impulse(Event Player, Normalize(Velocity Of(Event Player)) * -1 * 1, Speed Of(Event Player), To World,
			Incorporate Contrary Motion);
	}
}
rule("Subroutine CancelUltimate")
{
	event
	{
		Subroutine;
		CancelUltimate;
	}

	actions
	{
		Log To Inspector(Custom String("{0} - Cancelled Ultimate", Event Player));
		Event Player.TempFreeMode = Event Player.FreeMode;
		Event Player.FreeMode = True;
		Event Player.Resetting = True;
		Kill(Event Player, Null);
		disabled Start Forcing Player To Be Hero(Event Player, Hero Of(Event Player) == Hero(Reaper) ? Hero(Tracer) : Hero(Reaper));
		Resurrect(Event Player);
		disabled Start Forcing Player To Be Hero(Event Player, Global.Settings[11]);
		Wait(0.04, Ignore Condition);
		Event Player.FreeMode = Event Player.TempFreeMode;
		Event Player.Resetting = False;
		disabled Set Status(Event Player, Null, Stunned, 0.008);
	}
}
rule("Subroutine SetCurrentAbilities")
{
	event
	{
		Subroutine;
		SetCurrentAbilities;
	}

	actions
	{
		Log To Inspector(Custom String("{0} - SetCurrentAbilities", Event Player));
		If(Event Player.FreeMode || Event Player.Finished);
			Abort;
		End;

		Set Ability 1 Enabled(Event Player, Event Player.Ability1);
		Set Ability 2 Enabled(Event Player, Event Player.Ability2);
		Set Ultimate Ability Enabled(Event Player, Event Player.Ultimate);
		Set Ultimate Charge(Event Player, Event Player.Ultimate ? 100 : 0);
		Set Crouch Enabled(Event Player, Event Player.Crouch);
		Set Jump Enabled(Event Player, Event Player.Jump);
		"// TODO: Add option to select wether disable crouch also disables mercy ow2 superjumps"
		If(Event Player.Crouch);
			Allow Button(Event Player, Button(Crouch));
		Else;
			Disallow Button(Event Player, Button(Crouch));
		End;
	}
}
rule("Subroutine EnableAllAbilities")
{
	event
	{
		Subroutine;
		EnableAllAbilities;
	}

	actions
	{
		Log To Inspector(Custom String("{0} - Enabled All Abilities", Event Player));
		Set Ability 1 Enabled(Event Player, True);
		Set Ability 2 Enabled(Event Player, True);
		Set Ultimate Ability Enabled(Event Player, True);
		Set Crouch Enabled(Event Player, True);
		Set Jump Enabled(Event Player, True);
		Allow Button(Event Player, Button(Crouch));
		Allow Button(Event Player, Button(Jump));
	}
}
rule("Subroutine PlayerCompletedRun")
{
	event
	{
		Subroutine;
		PlayerCompletedRun;
	}

	actions
	{
		If(Event Player.BestRun == False || (Event Player.BestRun[0] > Event Player.CurrentRunTime || (Event Player.BestRun[0] == Event Player.CurrentRunTime && Event Player.BestRun[1] > Event Player.Mistakes)));
			Event Player.BestRun = Array(Event Player.CurrentRunTime, Event Player.Mistakes);
			If(Is True For Any(Global.Scoreboard, Current Array Element[0] == Event Player.PlayerName));
				"// TODO: Fix this bs"
				Set Global Variable At Index(Scoreboard, Index Of Array Value(Global.Scoreboard, Filtered Array(Global.Scoreboard, Current Array Element[0] == Event Player.PlayerName)), 
					Array(Event Player.PlayerName, Event Player.BestRun[0], Event Player.BestRun[1], Hero Of(Event Player)));
				Log To Inspector(Custom String("{0} - Modified scoreboard", Event Player));
			Else;
				Modify Global Variable(Scoreboard, Append To Array, Array(Array(Event Player.PlayerName, Event Player.BestRun[0], Event Player.BestRun[1], Hero Of(Event Player))));
				Log To Inspector(Custom String("{0} - Added best run to scoreboard", Event Player));
			End;
			Global.Scoreboard = Sorted Array(Global.Scoreboard, Current Array Element[1]);
		End;
	}
}
rule("Subroutine Taw'sDecompressData")
{
	event
	{
		Subroutine;
		TawsDecompressData;
	}

	actions
	{
		"Workshop Setting: Single Use Shift/Unlimited GA (Affects all checkpoints)"
		Global.TawsEditorVariables[0] = False;
		"Workshop Setting: Default Checkpoint Radius"
		Global.TawsEditorVariables[1] = 2;
		"Taw's maps don't require that you grab all refresh orbs"
		Global.RequireGrabAllRefreshOrbs = False;

		"Give credits to the original editor maker"
		Global.VIPs[Count Of(Global.VIPs)] = Array(Custom String("Taw"), Custom String("Taw"), Color(Purple));

		Log To Inspector(Custom String("Decompressing Taw's Data..."));
		"CheckpointFlags"
		Global.TawsEditorVariables[2] = Empty Array;


		"Compression V2"
		If(Global.TawsCompressedData[Count Of(Global.TawsCompressedData) - 1] == 2);
			Global.TawsCompressedData = Array Slice(Global.TawsCompressedData, 0, Count Of(Global.TawsCompressedData) - 1);

			"Extract Teleport pads"
			Global.Teleports = Mapped Array(
				Global.TawsCompressedData, 
				Current Array Element[0][3][0]!= 0 ? 
					Array(
						Current Array Element[0][3][0],
						Current Array Element[0][3][1], 
						False, 
						Current Array Element[0][3][2],
						Current Array Element[0][3][3]
					) : False);

			"Temp extract level flags"
			Global.TawsEditorVariables[2] = 
			Mapped Array(
				Mapped Array(
					Global.TawsCompressedData, 
					Array(
						(Current Array Element[4] - Round To Integer(Current Array Element[4] / 10, Down) * 10) % 8, 
						Round To Integer((Current Array Element[4] - Round To Integer(Current Array Element[4] / 1000, Down) * 1000) / 10, Down) / 10, 
						Round To Integer(Current Array Element[4] / 1000, Down) / 10
					)
				), 
				Array(
					Current Array Element[0] % 2 != 0, 
					0, 
					(Current Array Element[0] - Current Array Element[0] % 2) % 4 != 0,
					(Current Array Element[0] - Current Array Element[0] % 4) % 8 != 0, 
					0, 
					Current Array Element[2], 
					Current Array Element[1]
				)
			);
		
		"Compression V1"
		Else If(Global.TawsCompressedData[Count Of(Global.TawsCompressedData) - 1] == 1);
			Global.TawsCompressedData = Array Slice(Global.TawsCompressedData, 0, Count Of(Global.TawsCompressedData) - 1);
			"Extract Teleport pads"
			Global.Teleports = Mapped Array(Global.TawsCompressedData, 
				Array(Current Array Element[0][2],
				Global.TawsEditorVariables[1], 
				False, 
				Global.TawsEditorVariables[1], 
				Global.TawsEditorVariables[1]));

			Global.TawsEditorVariables[2] = Mapped Array(
				Global.TawsCompressedData, 
				Array(
					Current Array Element[4] % 2 != 0, 
					0, 
					(Current Array Element[4] - Current Array Element[4] % 2) % 4 != 0, 
					(Current Array Element[4] - Current Array Element[4] % 4) % 8 != 0,
					0, 
					Global.TawsEditorVariables[1], 
					(Current Array Element[4] - Current Array Element[4] % 4) % 8 != 0 ? 0.200 : Global.TawsEditorVariables[1]
				)
			);
		"Compression V0"
		Else;	
			"Extract Teleports"
			Global.Teleports = Mapped Array(Global.TawsCompressedData, Array(Current Array Element[0][1], Global.TawsEditorVariables[1],
				Global.TawsEditorVariables[1], Global.TawsEditorVariables[1], False));
			Global.TawsEditorVariables[2] = Mapped Array(Global.TawsCompressedData, Array(Current Array Element[4] % 2 != 0, 0, (
				Current Array Element[4] - Current Array Element[4] % 2) % 4 != 0, (Current Array Element[4] - Current Array Element[4] % 4)
				% 8 != 0, 0, Global.TawsEditorVariables[1], (Current Array Element[4] - Current Array Element[4] % 4)
				% 8 != 0 ? 0.200 : Global.TawsEditorVariables[1]));
		End;

		"Extract Checkpoint coordinates, radius and facing direction"
		Global.Checkpoints = Mapped Array(
			Global.TawsCompressedData, 
			Array(
				Current Array Element[0][0],
				Current Array Element[0][1] == 0 ? Global.TawsEditorVariables[1] : Current Array Element[0][1],
				Current Array Element[0][2] == 0 ? False : Current Array Element[0][2])
			);                                       

		"Extract Bots, Orbs, Flags"
		For Global Variable(i, 0, Count Of(Global.Checkpoints), 1);
			Global.TempArray = Empty Array;
			If(Global.TawsCompressedData[Global.i][1][0] == 0);
				Global.TempArray = False;
			Else;
				For Global Variable(j, 0, Count Of(Global.TawsCompressedData[Global.i][1]), 2);
					"Translate bot data and flags -> Array(Coords, CrouchEnabled, GravityEnabled)"
					Global.TempArray[Global.j / 2] =
						Array(
							Global.TawsCompressedData[Global.i][1][Global.j],
							False,
							((Global.TawsCompressedData[Global.i][1][Global.j + 1] - Global.TawsCompressedData[Global.i][1][Global.j + 1] % 2) % 4 == 0),
							(Global.TawsCompressedData[Global.i][1][Global.j + 1] % 2 != 0),
							False,
							False
						);
				End;
			End;
			"Store Bot array to global data"
			Global.Bots[Global.i] = Count Of(Global.TempArray) > 0 ? Global.TempArray : False;
			Global.TempArray = Empty Array;			

			"Extract Orbs/Antiorbs for this level"
			For Global Variable(j, 0, Count Of(Global.TawsCompressedData[Global.i][2]), 2);
				"Transform orb data"
				Global.TempArray[Global.j / 2] =  Array(
					Global.TawsCompressedData[Global.i][2][Global.j],
					Global.TawsCompressedData[Global.i][2][Global.j + 1]);
				
			End;
			"Store Orb Array to global data"
			Global.Orbs[Global.i] = Filtered Array(Global.TempArray, Current Array Element[1] > 0);
			"// TODO: Search for more efficient cleanup operation"
			If(Count Of(Global.Orbs[Global.i]) == 0);
				Global.Orbs[Global.i] = False;
			End;
			"Antiorbs are encoded with a negative Radius"
			Global.AntiOrbs[Global.i] = Mapped Array(
				Filtered Array(Global.TempArray, Current Array Element[1] < 0), 
				Array(Current Array Element[0], Current Array Element[1] * -1));
			"// TODO: Search for more efficient cleanup operation"
			If(Count Of(Global.AntiOrbs[Global.i]) == 0);
				Global.AntiOrbs[Global.i] = False;
			End;
			Global.TempArray = Empty Array;		

			"Extract Refresh Orbs"
			For Global Variable(j, 0, Count Of(Global.TawsCompressedData[Global.i][3]), 2);
				"Assume Refresh orbs with coordinates of 0 are not valid"
				If(Global.TawsCompressedData[Global.i][3][Global.j] != 0);
				"Transform Refresh Orb data"
				Global.TempArray[Count Of(Global.TempArray)] = Array(
					Global.TawsCompressedData[Global.i][3][Global.j],
					Global.TawsCompressedData[Global.i][3][Global.j + 1],
					Count Of(Global.TempArray),
					True,
					False,
					False);
				End;
			End;
			Global.RefreshOrbs[Global.i] = Count Of(Global.TempArray) > 0 ? Global.TempArray : False;
			Global.TempArray = Empty Array;		
			"Save Checkpoint flags"
			Modify Global Variable At Index(Checkpoints, Global.i, Append To Array, 
			Array(Global.TawsEditorVariables[2][Global.i][2], 
			Global.TawsEditorVariables[2][Global.i][3], 
			Global.TawsEditorVariables[2][Global.i][5], 
			Global.TawsEditorVariables[2][Global.i][6],
			Global.TawsEditorVariables[0]));

			Wait(0.016, Ignore Condition);
		End;
		
		If(Global.TawsCPProps != Null);
			If(Global.TawsCPProps[0] != Null);
				Global.Settings[0] = Array(Global.TawsCPProps[0]);
			End;
			"Translate Taw's CPProps to Giga editor settings"
			Global.TawsEditorVariables = Array(False, 10, 13, False, 11, -1, 7, 5, False, 12, False, False, 10, 11, False, False, -2, False, False, 9, 8, 3);
			For Global Variable(i, 1, Count Of(Global.TawsEditorVariables), 1);
				If(Global.TawsCPProps[Absolute Value(Global.TawsEditorVariables[Global.i])] != Null && Global.TawsEditorVariables[Global.i] != False);
					Global.Settings[Global.i] = Global.TawsEditorVariables[Global.i] > 0 ? 
						Global.TawsCPProps[Global.TawsEditorVariables[Global.i]] :
						Array(Global.TawsCPProps[Absolute Value(Global.TawsEditorVariables[Global.i])]);
				End;
			End;
			disabled If(Global.TawsCPProps[1] != Null);
			disabled 	Global.Settings[5] = Array(Global.TawsCPProps[1]);
			disabled End;
			disabled If(Global.TawsCPProps[2] != Null);
			disabled 	Global.Settings[16] = Array(Global.TawsCPProps[2]);
			disabled End;
		End;
		If(Global.OrbStyle == 0);
			Global.OrbStyle = 2;
		End;
		If(Global.RefreshOrbStyle == 0);
			Global.RefreshOrbStyle = 3;
		End;
		If(Global.TawsCheckpointInWorldText != Null);
			Global.WorldTexts = Mapped Array(
				Global.TawsCheckpointInWorldText, 
				Current Array Element != 0 ?
				Array(
					Current Array Element[0],
					Current Array Element[1],
					Current Array Element[3],
					Current Array Element[2]) : False);
		End;
		Global.TawsCompressedData = Null;
		Global.TawsEditorVariables = Null;
		Global.TempArray = Null;
		Global.i = 0;
		Global.j = 0;
	}
}
rule("Subroutine PeaceDecompressData")
{
	event
	{
		Subroutine;
		PeaceDecompressData;
	}

	actions
	{
		"Workshop setting: Bot Floating?"
		Global.PeaceEditorVariables[0] = True;
		"Workshop setting: Land On Arrival Point?"
		Global.PeaceEditorVariables[1] = False;
		"Default orb radius. Peace orbs are larger than they appear, their true size is around 0.5"
		Global.PeaceEditorVariables[4] = 0.8;
		"Peace Jump cloud radius. If some your jump clouds act weird move in small increments"
		Global.PeaceEditorVariables[7] = 1;
		"Peace editor rules require player to grab all refresh orbs"
		Global.RequireGrabAllRefreshOrbs = True;
		"Peace editor stores unused bots near these coordinates"
		Global.BotPenCoords = Vector(-500, -500, -500);

		"Give credits to the original editor maker"
		Global.VIPs[Count Of(Global.VIPs)] = Array(Custom String("Peace"), Custom String("{0} Peace", Ability Icon String(Hero(Mercy), Button(Ability 2))), Color(White));

		Log To Inspector(Custom String("Peace Decompress Data start"));
		"Filter all checkpoints that are not teleport levels"
		Global.PeaceEditorVariables[2] = Filtered Array(Global.PeaceCheckpoint, Current Array Element[5] == False);

		"Extract all non-teleport checkpoints. Assume facingdirection=false, Landing thresholds = 1"
		Global.Checkpoints = Mapped Array(Global.PeaceEditorVariables[2], 
		Array(
			Current Array Element[0],
			Current Array Element[1],
			False,
			Current Array Element[2],
			Global.PeaceEditorVariables[1],
			Current Array Element[1],
			Current Array Element[1],
			Current Array Element[4])
		);

		"Extract initial bots. // TODO: We dont have compatibility for bot floating using jump yet, crouch is not a 1:1 replacement for this"
		Global.Bots = 
			Mapped Array(Global.PeaceEditorVariables[2],
			Current Array Element[3] != False ? Array(Array(
				Current Array Element[3][0],
				False,
				False,
				!Global.PeaceEditorVariables[0],
				Current Array Element[3][1],
				Current Array Element[3][2])) : Array(False)
		);
		"Teleport CP counter, do not modify"
		Global.PeaceEditorVariables[6] = 0;
		"Extract and translate level effects"
		For Global Variable(i, 0, Count Of(Global.Checkpoints), 1);
			Log To Inspector(Custom String("Extracting CP. {0}", Global.i));
			
			"Extract level Normal Orbs"
			Global.Orbs[Global.i] = 
				Mapped Array(
					Filtered Array(
						Global.PeaceEditorVariables[2][Global.i][6],
						Current Array Element[1] == False), 
					Count Of(Current Array Element) > 0 ? 
						Array(Current Array Element[0], Global.PeaceEditorVariables[4]) : False
				);
			"Cleanup empty orb array"
			If(Global.Orbs[Global.i][0] == False);
				Global.Orbs[Global.i] = False;
			End;
			
			"Extract level Antiorbs"
			Global.AntiOrbs[Global.i] = 
				Count Of(Global.PeaceEditorVariables[2][Global.i][7]) > 0 ? 
				Global.PeaceEditorVariables[2][Global.i][7] : False;

			"Extract level Clouds, assume Radius of 1"
			Global.Clouds[Global.i] = 
				Count Of(Global.PeaceEditorVariables[2][Global.i][8]) > 0 ? 
				Mapped Array(
					Global.PeaceEditorVariables[2][Global.i][8], 
					Array(
						Current Array Element[0], 
						Global.PeaceEditorVariables[7], 
						Current Array Element[1])
				) : False;

			
			"Create a teleport pad in levels where the next cp has the teleport flag enabled"
			If(Global.PeaceCheckpoint[Global.i + Global.PeaceEditorVariables[6] + 1][5] == True);
				Global.Teleports[Global.i] = Array(
						Global.PeaceCheckpoint[Global.i + Global.PeaceEditorVariables[6] + 1][0],
						Global.PeaceCheckpoint[Global.i + Global.PeaceEditorVariables[6] + 1][1],
						False,
						Global.PeaceCheckpoint[Global.i + Global.PeaceEditorVariables[6] + 1][1],
						Global.PeaceCheckpoint[Global.i + Global.PeaceEditorVariables[6] + 1][1]
					);
				Global.PeaceEditorVariables[6] += 1;
			Else;
				Global.Teleports[Global.i] = False;
			End;
			
			"Temporarily extract level Multi-GA orbs"
			Global.PeaceEditorVariables[3] = Filtered Array(Global.PeaceEditorVariables[2][Global.i][6], Current Array Element[1] != False);

			"If no Multi-GA orbs, level extraction is complete"
			If(Count Of(Global.PeaceEditorVariables[3]) == 0);
				Global.RefreshOrbs[Global.i] = False;

				"Clean up empty bot array"
				If(Global.Bots[Global.i][0] == False);
					Global.Bots[Global.i] = False;
				End;
			Else;
				Global.RefreshOrbs[Global.i] = Empty Array;
				
				"Mapped array wont work with multidimensional arrays... why blizz? :/"
				For Global Variable(j, 0, Count Of(Global.PeaceEditorVariables[3]), 1);
					"Extract Multi-GA level bots"
					Modify Global Variable At Index(Bots, Global.i, Append To Array,
						Array(Array(
							Global.PeaceEditorVariables[3][Global.j][1],
							False,	
							False,
							!Global.PeaceEditorVariables[0],
							Global.PeaceEditorVariables[3][Global.j][2],
							Global.PeaceEditorVariables[3][Global.j][3]
						))
					);

					"Extract level Refresh orbs, leave out the bot section # for now"
					Modify Global Variable At Index(RefreshOrbs, Global.i, Append To Array,
						Array(Array(
							Global.PeaceEditorVariables[3][Global.j][0],
							Global.PeaceEditorVariables[4],
							Global.j + 1,
							True,
							False,
							False
						))
					); 
				End;
			End;
			Wait(0.004, Ignore Condition);
		End;

		"Translate Peace's customization options"
		If(Global.PeaceConfig != Null);
			Global.PeaceEditorVariables = Array(False, 42, 40, 41, 44, -7, 4, False, False, 9, False, False, 43, 45, False, 25, -6, False, 12, False, 1, 5);
			If(Global.PeaceConfig[0] != Null);
				Global.Settings[0] = Array(Global.PeaceConfig[0]);
			End;
			For Global Variable(i, 1, Count Of(Global.PeaceEditorVariables), 1);
				If(Global.PeaceConfig[Absolute Value(Global.PeaceEditorVariables[Global.i])] != Null && Global.PeaceEditorVariables[Global.i] != False);
					Global.Settings[Global.i] = Global.PeaceEditorVariables[Global.i] > 0 ? 
						Global.PeaceConfig[Global.PeaceEditorVariables[Global.i]] : 
						Array(Global.PeaceConfig[Absolute Value(Global.PeaceEditorVariables[Global.i])]);
				End;
			End;
			"Extract default Goal CP text, multilanguage support coming soon"
			Global.Settings[7] = Global.PeaceConfig[2][0];
			"Goal checkpoint effect color"
			disabled Global.Settings[16] = Array(Global.PeaceConfig[6]);
			"Modify scoreboard text if the mapmaker changed it"
			Global.Settings[17] = String Length(Global.PeaceConfig[24]) > 1 ? Global.PeaceConfig[24] : Global.Settings[17];
			Modify Global Variable(VIPs, Append To Array, Global.PeaceVips);
		End;
		If(Global.PeaceTop5Color != Null);
			Global.Top5Colors = Global.PeaceTop5Color;
		End;
		If(Global.OrbStyle == 0);
			Global.OrbStyle = 1;
		End;
		If(Global.RefreshOrbStyle == 0);
			Global.RefreshOrbStyle = 1;
		End;
		If(Count Of(Global.PeaceOrTawsVar) > 0 && String Length(Global.PeaceOrTawsVar[0]) > 0);
			Global.HintTexts = Mapped Array(Global.PeaceOrTawsVar, Current Array Element == 0 ? False : Current Array Element);
		End;
		"Cleanup"
		Global.PeaceCheckpoint = Null;
		Global.PeaceVips = Null;
		Global.PeaceEditorVariables = Null;
		Global.PeaceConfig = Null;
		Global.PeaceTop5Color = Null;
		disabled Global.WorldTexts = Null;
		disabled Global.BigMessages = Null;
		disabled Global.SmallMessages = Null;
		Global.PeaceOrTawsVar = Null;

		Log To Inspector(Custom String("Peace Decompress Data End"));
	}
}
rule("Subroutine CreateCurrentWorldTexts")
{
	event
	{
		Subroutine;
		CreateCurrentWorldTexts;
	}
	actions
	{
		Destroy In-World Text(Event Player.CheckpointWorldTexts);
		Create In-World Text(Event Player, Global.WorldTexts[Event Player.Checkpoint][0], Global.WorldTexts[Event Player.Checkpoint][1], Global.WorldTexts[Event Player.Checkpoint][2], Do Not Clip, Visible To And String, Global.WorldTexts[Event Player.Checkpoint][3], Default Visibility);
		Event Player.CheckpointWorldTexts = Last Text Id;
	}
}
rule("——————————————————————————Add-ons——————————————————————————")
{
	event
	{
		Ongoing - Global;
	}
}
rule("Server load widget by GigaMercy")
{
	event
	{
		Ongoing - Global;
	}
	conditions
	{
		Global.ServerLoad == True;
	}
	actions
	{
		"Color depends on AVG server load. Red: >75% | Orange: >50% | Green: below 50%"
		Create HUD Text(All Players(All Teams), Null, Custom String("Server Load: {0}%, Avg: {1}%, Peak: {2}%", Round To Integer(Server Load * 0.39, Up), Round To Integer(Server Load Average * 0.39, Up), Round To Integer(Server Load Peak* 0.39, Up)),
		Null, Right, 0, Null, Server Load Average > 192 ? Color(Red) : Server Load Average > 128 ? Color(Orange) : Color(Green), Null, Visible To String and Color, Default Visibility);
		
		"Color depends on % used effects. Red: >75% | Orange: >50% | Green: below 50%"
		Create HUD Text(All Players(All Teams), Null, Custom String("Effect count {0}/256", Entity Count),
		Null, Right, 0, Null, Entity Count > 192 ? Color(Red) : Entity Count > 128 ? Color(Orange) : Color(Green), Null, Visible To String and Color, Default Visibility);
		
		"No need to enable this unless your map has a lot of in-world texts or icons\nColor depends on % used texts. Red: >75% | Orange: >50% | Green: below 50%"
		disabled Create HUD Text(All Players(All Teams), Null, Custom String("Text count {0}/128", Text Count),
		Null, Right, 0, Null, Text Count > 96 ? Color(Red) : Text Count > 64 ? Color(Orange) : Color(Green), Null, Visible To String and Color, Default Visibility);	
	}
}