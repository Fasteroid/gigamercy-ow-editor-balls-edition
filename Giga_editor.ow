rule("Global Config")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		"------Colors------"
		disabled continue;
		"Start Checkpoint Ring Color"
		Global.Config[0] = Color(Blue);
		"Goal Checkpoint Ring Color"
		Global.Config[5] = Color(Aqua);
		"Goal Checkpoint text Color"
		Global.Config[6] = Color(White);
		"Teleport pad effect color"
		Global.Config[9] = Color(Yellow);
		"Orb color"
		Global.Config[1] = Color(Yellow);
		"Orb Icon Color"
		Global.Config[12] = Color(Yellow);
		"Refresh Orb Color"
		Global.Config[4] = Color(Violet);
		"Refresh Orb Icon Color"
		Global.Config[13] = Color(Violet);
		"Anti-Orb Color"
		Global.Config[2] = Color(Red);
		"Jump Cloud Color"
		Global.Config[3] = Color(Red);

		"------Texts & Icons------"
		disabled continue;
		"Goal Checkpoint text"
		Global.Config[7] = Custom String("Goal");
		"Teleport pad Text or Icon"
		Global.Config[8] = Icon String(Spiral);
		
		"------Bot & Player Settings------"
		disabled continue;
		"Bot Hero"
		Global.Config[10] = Hero(Mercy);
		"Player Hero"
		Global.Config[11] = Hero(Mercy);
		"Where to store unused bots by default"
		Global.BotPenCoords = Vector(0, 200, 0);
	}
}
rule("Creator and Code")
{
	event
	{
		Ongoing - Global;
	}
	actions
	{
		"Your author(s) here"
		Global.CreatorAndCode[0] = Custom String("Author");
		"Your workshop code here"
		Global.CreatorAndCode[1] = Custom String("Code");
		"Only edit this if you want a custom map title"
		Global.MapTitle = Custom String("{0} Parkour {1} by {2}", Global.Config[11], Current Map, Custom String("{0}\nCode: {1}", Global.CreatorAndCode[0], Global.CreatorAndCode[1]));
	}
}

rule("——————————————————————————Initialization Settings——————————————————————————")
{
	event
	{
		Ongoing - Global;
	}
}

rule("1. Global Initialization")
{
	event
	{
		Ongoing - Global;
	}
	actions
	{
		Call Subroutine(InitializeGlobalVariables);
		If(!Global.DebugMode);
			Disable Inspector Recording;
		End;
		Disable Built-In Game Mode Announcer;
		Disable Built-In Game Mode Completion;
		Disable Built-In Game Mode Music;
		Disable Built-In Game Mode Scoring;
		Disable Built-In Game Mode Respawning(All Players(All Teams));		
		"TODO: Figure why match time is setup like this in taws and peace"
		If(Current Game Mode != Game Mode(Skirmish));
			Set Match Time(1);
		Else;
			Set Match Time(0);
			"Possible cause for mercy dialogue?"
			disabled Start Game Mode;	
		End;
		Pause Match Time;
		Stop Forcing Spawn Room(All Teams);

	}
}

rule("2. Player Initialization")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Has Spawned(Event Player) == True;
	}

	actions
	{
		Log To Inspector(Custom String("Initializing player {0}...", Event Player));
		Start Forcing Player To Be Hero(Event Player, Global.Config[11]);
		Disable Game Mode HUD(Event Player);
		Enable Death Spectate All Players(Event Player);
		Enable Death Spectate Target HUD(Event Player);
		"Disable me if you need spawn room walls in your map (Assault/Hybrid/Escort maps only)"
		disabled Start Forcing Spawn Room(Team 1, Color(Red));
		disabled Start Forcing Spawn Room(Team 2, Color(Red));
		Set Status(Event Player, Null, Invincible, 9999);
		Disable Movement Collision With Players(Event Player);
		Call Subroutine(InitializePlayerVariables);
		Call Subroutine(CreatePlayerHUD);
		If(Global.EditMode);
			Call Subroutine(CreatePlayerEditModeHUD);
			Call Subroutine(InitializePlayerBot);
		Else If(Is True for Any(Global.Bots, Current Array Element == True));
			Call Subroutine(InitializePlayerBot);
		End;
		Call Subroutine(TeleportToCurrentCheckpoint);
		Call Subroutine(SetUpCheckpoint);
	}
}

rule("3. Decompress Data")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		"Detect GigaEditor data"
		If (Global.MapData);
			Call Subroutine(DecompressMapData);
		"Detect Taw's Editor data"
		Else If (Global.CompressedData);
			Call Subroutine(TawsDecompressData);
		Else If (Global.Checkpoint);
			Wait Until(Has Spawned(Host Player), 9999);
			Big Message(All Players(All Teams), Custom String("Peace editor maps are not supported yet:("));
		End;
		Log To Inspector(Custom String("Decompression ended"));
	}
}


rule("——————————————————————————Controls——————————————————————————")
{
	event
	{
		Ongoing - Global;
	}
}
rule("Press [Interact] twice to view/hide controls")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Melee)) == False;
		Is Button Held(Event Player, Button(Jump)) == False;
		Is Button Held(Event Player, Button(Ability 1)) == False;
		Is Button Held(Event Player, Button(Ability 2)) == False;
		Is Button Held(Event Player, Button(Ultimate)) == False;
		Is Button Held(Event Player, Button(Reload)) == False;
	}
	actions
	{
		Wait Until(!Is Button Held(Event Player, Button(Interact)), 99999);
		Wait Until(Is Button Held(Event Player, Button(Interact)), 0.300);
		If(Is Button Held(Event Player, Button(Interact)));
			If(!Array Contains(Global.ShowSidebarControlsPlayers, Event Player));
				Modify Global Variable(ShowSidebarControlsPlayers, Append To Array, Event Player);
			Else;
				Modify Global Variable(ShowSidebarControlsPlayers, Remove From Array By Value, Event Player);
			End;
		End;
	}
}
rule("Press [Ability 2] + [Melee] + [Primary/Secondary Fire] to switch checkpoints")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Button Held(Event Player, Button(Ability 2)) == True;
		Is Button Held(Event Player, Button(Melee)) == True;
		(Is Button Held(Event Player, Button(Primary Fire)) ||
		Is Button Held(Event Player, Button(Secondary Fire))) == True;
	}
	actions
	{
		Event Player.TempFreeMode = Event Player.FreeMode;
		Event Player.FreeMode = True;
		If(Is Button Held(Event Player, Button(Primary Fire)));
			If(Event Player.Checkpoint < Count Of(Global.Checkpoints) - 1);
				Event Player.Checkpoint += 1;
			Else;
				Event Player.Checkpoint = 0;
			End;
		Else If(Is Button Held(Event Player, Button(Secondary Fire)));
			If(Event Player.Checkpoint > 0);
				Event Player.Checkpoint -= 1;
			Else If(Event Player.Checkpoint == 0);
				Event Player.Checkpoint = Count Of(Global.Checkpoints) - 1;
			End;
		End;	
		Call Subroutine(TeleportToCurrentCheckpoint);
		Event Player.FreeMode = Event Player.TempFreeMode;

		Call Subroutine(SetUpCheckpoint);
		Wait(0.016, Abort When False);
	}
}
rule("Press [Reload] to reset current checkpoint")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Button Held(Event Player, Button(Reload)) == True;
		Is Button Held(Event Player, Button(Jump)) == False;
		Is Button Held(Event Player, Button(Ultimate)) == False;
		Is Button Held(Event Player, Button(Ability 1)) == False;
		Is Button Held(Event Player, Button(Ability 2)) == False;
	}
	actions
	{
		"Sometimes going into free mode triggered this rule, if the keys were released in a specific order"
		If(Is Button Held(Event Player, Button(Crouch)) == True || Is Button Held(Event Player, Button(Melee)) == True);
			Abort;
		End;
		Call Subroutine(TeleportToCurrentCheckpoint);
		If(Event Player.LeftCheckpoint && Event Player.FreeMode == False);
			Call Subroutine(ResetWithMistake);
		Else;
			Call Subroutine(ResetCheckpoint);
		End;
	}
}
rule("Press [Crouch] + [Interact] + [Ability 2] to restart run")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Button Held(Event Player, Button(Crouch)) == True;
		Is Button Held(Event Player, Button(Interact)) == True;
		Is Button Held(Event Player, Button(Ability 2)) == True;		
		Is Button Held(Event Player, Button(Melee)) == False;
		Is Button Held(Event Player, Button(Jump)) == False;
		Is Button Held(Event Player, Button(Ability 1)) == False;
		Is Button Held(Event Player, Button(Ultimate)) == False;
		Is Button Held(Event Player, Button(Reload)) == False;
	}
	actions
	{
		Play Effect(Event Player, Tracer Recall Disappear Sound, Null, Event Player, 100);
		"Anti abuse measure"
		If(Event Player.Checkpoint == 0);
			Abort;
		End;
		Event Player.Checkpoint = 0;
		Event Player.Mistakes = 0;
		"TODO: reset player timers, bots, etc."
		Event Player.FreeMode = True;
		Call Subroutine(TeleportToCurrentCheckpoint);
		Event Player.FreeMode = False;
		Call Subroutine(SetUpCheckpoint);
	}
}
rule("Press [Reload] + [Jump] to toggle 3rd person camera")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Button Held(Event Player, Button(Reload)) == True;
		Is Button Held(Event Player, Button(Jump)) == True;
		Is Button Held(Event Player, Button(Interact)) == False;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Melee)) == False;
		Is Button Held(Event Player, Button(Ability 1)) == False;
		Is Button Held(Event Player, Button(Ability 2)) == False;
		Is Button Held(Event Player, Button(Ultimate)) == False;
	}
	actions
	{
		Wait(0.6, Abort When False);
		Small Message(Event Player, Custom String("3rd Person not implemented yet"));
	}
}
rule("Press [Reload] + [Interact] to TP to player")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Button Held(Event Player, Button(Reload)) == True;
		Is Button Held(Event Player, Button(Interact)) == True;
		Is Button Held(Event Player, Button(Jump)) == False;
		Is Button Held(Event Player, Button(Crouch)) == False;
		Is Button Held(Event Player, Button(Melee)) == False;
		Is Button Held(Event Player, Button(Ability 1)) == False;
		Is Button Held(Event Player, Button(Ability 2)) == False;
		Is Button Held(Event Player, Button(Ultimate)) == False;
	}
	actions
	{
		Small Message(Event Player, Custom String("TP not implemented yet"));
	}
}
