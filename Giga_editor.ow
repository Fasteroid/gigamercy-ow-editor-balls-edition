rule("BunnyHop: Using Mercy's sling/superjump loses the bhop")
{
	event
	{
		Ongoing - Each Player;
		All;
		Mercy;
	}
	conditions
	{
		Is Using Ability 1(Event Player) == True;
		Event Player.BhopActive == True;
	}
	actions
	{
		Log To Inspector(Custom String("{0} - Mercy bunnyhop check", Event Player));
		"Ignore Crouch-GA starting crouch"
		Wait Until((Is Button Held(Event Player, Button(Crouch)) && Event Player.Crouch) == False, 9999);
		"Ignore Gliding"
		Wait Until((Is Button Held(Event Player, Button(Jump)) && Event Player.Jump) == False, 9999);

		"Release GA button first"
		Wait Until(Is Button Held(Event Player, Button(Ability 1)) == False, 9999);

		
		Wait Until(
			(Is Using Ability 1(Event Player) == False) ||
			(
				(Is Button Held(Event Player, Button(Jump)) && Event Player.Jump) || 
				(Is Button Held(Event Player, Button(Crouch)) && Event Player.Crouch)
			) == True, 9999);
		If(Is Using Ability 1(Event Player) && !Is Button Held(Event Player, Button(Ability 1)));
			Event Player.BhopActive = False;
		Else If(Global.DebugMode == True);
			Small Message(Event Player, Custom String("Successful bhop cancel, dist to ground {0}", Altitude Of(Event Player)));
		End;
	}
}
rule("BunnyHop: Mercy SJ while touching ground resets bhop")
{
