rule("Create Start and Finish checkpoints")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Has Spawned(Event Player) == True;
		Is Dummy Bot(Event Player) == False;	
	}
	actions
	{
		"Create start checkpoint Ring"
		Create Effect(Event Player, Ring, Global.Config[0], Global.Checkpoints[Event Player.Checkpoint][0], 
		Global.Checkpoints[Event Player.Checkpoint][1], Visible To Position Radius and Color);
		"Create Goal checkpoint Ring"
		Create Effect(Global.Checkpoints[Event Player.Checkpoint + 1 ] ? Event Player : Null, Ring, Global.Config[5], Event Player.GoalCoords, Event Player.GoalRadius, Visible To Position Radius and Color);
		"Create Goal checkpoint Sparkles"
		Create Effect(Global.Checkpoints[Event Player.Checkpoint + 1 ] ? Event Player : Null, Sparkles, Global.Config[5], Event Player.GoalCoords, Event Player.GoalRadius, Visible To Position Radius and Color);
		"Create Goal checkpoint Icon"
		Create Icon(Global.Checkpoints[Event Player.Checkpoint + 1 ] && !Global.Teleports[Event Player.Checkpoint] ? Event Player : Null, Event Player.GoalCoords + Vector(0, 2, 0), Flag, Visible To Position and Color, Global.Config[5], True);
		"Create Goal checkpoint Text"
		Create In-World Text(Global.Checkpoints[Event Player.Checkpoint + 1] ? Event Player : Null, Global.Teleports[Event Player.Checkpoint] ? Global.Config[8] : Global.Config[7], Event Player.GoalCoords + Vector(0, 1, 0), 1.5, Do Not Clip, Visible To Position and String, Global.Config[6], Default Visibility);
	}
}
