rule("Calculate rainbow")
{
	event
	{
		Ongoing - Global;
	}
	conditions
	{
		GLobal.DebugMode == False;
	}
	actions
	{
		While(Global.RGB[1] < 255);
			Global.RGB[1] += 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[2] > 0);
			Global.RGB[2] -= 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[0] < 255);
			Global.RGB[0] += 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[1] > 0);
			Global.RGB[1] -= 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[2] < 255);
			Global.RGB[2] += 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[0] > 0);
			Global.RGB[0] -= 3;
			Wait(0.016, Ignore Condition);
		End;
		Loop;
	}
}
rule("——————————————————————————Parkour Engine rules——————————————————————————")
{
	event
	{
		Ongoing - Global;
	}
}

rule("Detect Leaving checkpoint")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
		Distance Between(Event Player, Global.Checkpoints[Event Player.Checkpoint][0]) 
		> Global.Checkpoints[Event Player.Checkpoint][1];
	}
	actions
	{
		Event Player.LeftCheckpoint = True;
		Chase Player Variable At Rate(Event Player, CurrentRunTime, 20000, 1, Destination and Rate);
	}
}
rule("Detect Landing Outside")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
		Is On Ground(Event Player) == True;
		"TODO: Agregar logica para niveles con teleports"
		Distance Between(Event Player, Global.Checkpoints[Event Player.Checkpoint][0]) 
		> Global.Checkpoints[Event Player.Checkpoint][1];
	}
	actions
	{
		Abort If(Distance Between(Event Player, Event Player.GoalCoords) <= Event Player.GoalRadius &&
		((Y Component Of(Position Of(Event Player)) <= (Y Component Of(Event Player.GoalCoords) + Event Player.GoalThresholds[0])) &&
		(Y Component Of(Position Of(Event Player)) >= Y Component Of(Event Player.GoalCoords) - Event Player.GoalThresholds[1])) == True);

		If(Event Player.Checkpoint == 0);
			Stop Chasing Player Variable(Event Player, CurrentRunTime);
			Event Player.CurrentRunTime = 0;
		End;

		"Too Annoying"
		disabled Small Message(Event Player, Custom String("You need to land inside the Goal!"));
		disabled Play Effect(Event Player, Debuff Impact Sound, Null, Event Player, 100);
		Call Subroutine(ResetWithMistake);
	}
}
rule("Detect Arriving on Goal or Teleport")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
		"Deprecated: Use LeftCheckpoint instead"
		disabled ((Distance Between(Event Player, Global.Checkpoints[Event Player.Checkpoint][0]) 
		> Global.Checkpoints[Event Player.Checkpoint][1]) || Event Player.LeftCheckpoint) == True;
		Event Player.LeftCheckpoint == True;
		"TODO: Get OnGround flag from current goal in case the level has a teleport"
		((Global.Checkpoints[Event Player.Checkpoint + 1][4] && Is On Ground(Event Player)) ||
		!Global.Checkpoints[Event Player.Checkpoint + 1][4]) == True;
		Distance Between(Event Player, Event Player.GoalCoords) <= Event Player.GoalRadius;
		((Y Component Of(Position Of(Event Player)) <= Y Component Of(Event Player.GoalCoords) + Event Player.GoalThresholds[0]) &&
		(Y Component Of(Position Of(Event Player)) >= Y Component Of(Event Player.GoalCoords) - Event Player.GoalThresholds[1])) == True;
	}
	actions
	{
		If(Is True For Any(Event Player.GrabbedOrbs, Current Array Element == False) && (Count Of(Event Player.GrabbedOrbs) > 0));
			Small Message(Event Player, Custom String("You need to grab all the orbs!"));
			Play Effect(Event Player, Debuff Impact Sound, Null, Event Player, 100);
			Call Subroutine(ResetWithMistake);
		Else If(Is True For Any(Event Player.GrabbedRefreshOrbs, Current Array Element == False) && (Count Of(Event Player.GrabbedOrbs) > 0) && Global.RequireGrabAllRefreshOrbs);
			Small Message(Event Player, Custom String("You need to grab all the refresh orbs!"));
			Play Effect(Event Player, Debuff Impact Sound, Null, Event Player, 100);
			Call Subroutine(ResetWithMistake);
		Else If(Global.Bots[Event Player.Checkpoint] && !Event Player.BotCondition);
			Small Message(Event Player, Custom String("You need to rez the bot!"));
			Play Effect(Event Player, Debuff Impact Sound, Null, Event Player, 100);
			Call Subroutine(ResetWithMistake);
		Else;
			Event Player.Checkpoint += 1;
			"Player finished all checkpoints"
			If(Event Player.Checkpoint == Count Of(Global.Checkpoints) - 1);
				"TODO: Consider not duplicating this block if possible"
				If(Global.Teleports[Event Player.Checkpoint - 1]);
					Call Subroutine(TeleportToCurrentCheckpoint);
					Play Effect(Event Player, Sombra Translocator Reappear Sound, Null, Event Player, 100);
				End;
				Stop Chasing Player Variable(Event Player, CurrentRunTime);
				Play Effect(All Players(All Teams), Ring Explosion Sound, Null, Event Player, 100);
				"TODO: Set a color for finish explosion in config"
				Play Effect(All Players(All Teams), Good Pickup Effect, Color(Aqua), Global.Checkpoints[Event Player.Checkpoint][0], Global.Checkpoints[Event Player.Checkpoint][1]);
				Wait(0.1, Ignore Condition);
				Big Message(All Players(All Teams), Custom String("{0} Finished in {1} seconds", Event Player, Event Player.CurrentRunTime));
			"Player finished current checkpoint"
			Else;
				Small Message(Event Player, Custom String("Reached the goal:D"));
				If(Global.Teleports[Event Player.Checkpoint - 1]);
					Call Subroutine(TeleportToCurrentCheckpoint);
					Play Effect(Event Player, Sombra Translocator Reappear Sound, Null, Event Player, 100);
				Else;
					Play Effect(Event Player, Buff Explosion Sound, Null, Event Player, 100);
				End;
			End;
			Call Subroutine(SetUpCheckpoint);
		End;
	}
}
rule("Detect Grabbing Orb")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
		Count Of(Event Player.GrabbedOrbs) > 0;
		
		"TODO: Encontrar un mejor algoritmo de deteccion. De momento nos basamos en Peace"
		Is True For Any(Global.Orbs[Event Player.Checkpoint], 
		!Event Player.GrabbedOrbs[Current Array Index] && 
		(Distance Between(Position Of(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700 ||
		Distance Between(Eye Position(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700))
		== True;
	}
	actions
	{
		If(Event Player.BotCondition || True);
			Event Player.GrabbedOrbs = Mapped Array(Global.Orbs[Event Player.Checkpoint],
				Distance Between(Position Of(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700 ||
				Distance Between(Eye Position(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700
				|| Event Player.GrabbedOrbs[Current Array Index] ? True : False);
			Small Message(Event Player, Custom String("Orb Grab! {0}/{1}",
			Count Of(Filtered Array(Event Player.GrabbedOrbs, Current Array Element == True)),
			Count Of(Event Player.GrabbedOrbs)));
			Play Effect(Event Player, Buff Impact Sound, Null, Event Player, 100);
		Else;
			Small Message(Event Player, Custom String("You need to rez the bot!"));
			Call Subroutine(ResetWithMistake);
		End;
	}
}
rule("Detect Grabbing RefreshOrb")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
		Count Of(Event Player.GrabbedRefreshOrbs) > 0;
		
		"TODO: Encontrar un mejor algoritmo de deteccion. De momento nos basamos en Peace"
		Is True For Any(Global.RefreshOrbs[Event Player.Checkpoint], 
		!Event Player.GrabbedRefreshOrbs[Current Array Index] && 
		(Distance Between(Position Of(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700 ||
		Distance Between(Eye Position(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700))
		== True;
	}
	actions
	{
		If(Event Player.BotCondition);
			For Player Variable(Event Player, i, 0, Count Of(Event Player.GrabbedRefreshOrbs), 1);
				If(!Event Player.GrabbedRefreshOrbs[Event Player.i] &&
				(Distance Between(Position Of(Event Player), Global.RefreshOrbs[Event Player.i][0]) <= Global.RefreshOrbs[Event Player.i][1] + 0.700 ||
				Distance Between(Eye Position(Event Player), Global.RefreshOrbs[Event Player.i][0]) <= Global.RefreshOrbs[Event Player.i][1] + 0.700));

					Event Player.GrabbedRefreshOrbs[Event Player.i] = True;
					Small Message(Event Player, 
					Custom String("Orb Grab! {0}/{1}, {2} also refreshed!",
						Count Of(Filtered Array(Event Player.GrabbedRefreshOrbs, Current Array Element == True)),
						Count Of(Event Player.GrabbedRefreshOrbs),
						Custom String("{0}{1}{2}", 
							Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][3] ? Ability Icon String(Hero Of(Event Player), Button(Ability 1)) : Empty Array,
							Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][4] ? Ability Icon String(Hero Of(Event Player), Button(Ability 2)) : Empty Array,
							Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][5] ? Ability Icon String(Hero Of(Event Player), Button(Ultimate)) : Empty Array
						)
					));
					Play Effect(Event Player, Buff Impact Sound, Null, Event Player, 100);
					"Trigger Bot Section"
					If(Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][2]);
						Event Player.CurrentBotSection = Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][2];
						Set Player Variable(Event Player.Bot, CurrentBotSection, Event Player.CurrentBotSection);
						Call Subroutine(UpdateBotPosition);
					End;
					Set Ability 1 Enabled(Event Player, Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][3] ? True : Null);
					Set Ability 2 Enabled(Event Player, Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][4] ? True : Null);
					Set Ultimate Ability Enabled(Event Player, Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][5] ? True : Null);
				End;
		Else;
			Small Message(Event Player, Custom String("You need to rez the bot!"));
			Call Subroutine(ResetWithMistake);
		End;
	}
}
rule("Detect Touching AntiOrb")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
		Global.AntiOrbs[Event Player.Checkpoint] == True;
		
		"TODO: Encontrar un mejor algoritmo de deteccion. De momento nos basamos en Peace"
		Is True For Any(Global.AntiOrbs[Event Player.Checkpoint], 
		(Distance Between(Position Of(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700 ||
		Distance Between(Eye Position(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700))
		== True;
	}
	actions
	{
		Set Status(Event Player, Null, Burning, 0.16);
		Call Subroutine(ResetWithMistake);
	}
}
disabled rule("TODO: Bot Condition")
{
