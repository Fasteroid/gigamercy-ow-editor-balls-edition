		Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][4] == False;
	}
	actions
	{
		Start Holding Button(Event Player, Button(Jump));
		Wait(30, Abort When False);
		Loop If Condition Is True;
	}
}
rule("Detect Using Ability 1 v2")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Using Ability 1(Event Player) == True;
		Event Player.Resetting == False;
	}
	actions
	{
		Log To Inspector(Custom String("{0} - Detected using GA", Event Player));
		Event Player.Ability1 = False;
		Wait Until(Ability Cooldown(Event Player, Button(Ability 1)) != 0, 99999);

		If(Event Player.FreeMode || Global.Checkpoints[Event Player.Checkpoint][7]);
			Wait(0.016, IgnoreCondition);
			Set Ability Cooldown(Event Player, Button(Ability 1), 0.1);
		Else;
			Set Ability 1 Enabled(Event Player, Event Player.Ability1);
			Wait(0.016, IgnoreCondition);
			"Disable this if you want to set the cooldowns through lobby settings"
			Set Ability Cooldown(Event Player, Button(Ability 1), 0);
		End;

		Log To Inspector(Custom String("{0} - Finished using GA", Event Player));
	}
}
rule("Detect Using Mercy Resurrect")
{
	event
	{
		Ongoing - Each Player;
		All;
		Mercy;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Using Ability 2(Event Player) == True;
		Event Player.FreeMode == False;
		Event Player.Finished == False;
		disabled Event Player.Resetting == False;
	}
	actions
	{
		Log To Inspector(Custom String("{0} - Detected using Mercy Rez", Event Player));
		Event Player.MercyRezTimer = 0;
		"Start chasing mercy resurrect time"
		Chase Player Variable At Rate(Event Player, MercyRezTimer, 99999, 1, None);
		Wait Until(!Is Using Ability 2(Event Player), 1.750);
		Stop Chasing Player Variable(Event Player, MercyRezTimer);


		If(Absolute Value(Event Player.MercyRezTimer - 1.750) < 0.050);
			Resurrect(Event Player.Bot);
			"// TODO: Rework this once we allow other bot ability rewards. ?___?"
			Small Message(Event Player, 
				Custom String("{0} Resurrected!{1}",
					Global.Settings[10],
					Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][6] ? 
					Custom String(", {0}{1}{2} also refreshed",
						Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][6] ? Ability Icon String(Hero Of(Event Player), Button(Ability 1)) : Empty Array,
						Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][7] ? Ability Icon String(Hero Of(Event Player), Button(Ability 2)) : Empty Array,
						Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][8] ? Ability Icon String(Hero Of(Event Player), Button(Ultimate)) : Empty Array
					) : Empty Array
				)
			);
			Set Ability 1 Enabled(Event Player, Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][6]);
			Set Ability 2 Enabled(Event Player, Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][7]);
			Set Ultimate Ability Enabled(Event Player, Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][8]);
			Event Player.BotCondition = True;
		Else;
			Set Ability 2 Enabled(Event Player, False);
		End;
	}
}
rule("Detect Using Secondary Fire")
{
	event
	{
		Ongoing - Each Player;
