rule("BunnyHop: Using Mercy's sling/superjump loses the bhop v2")
{
	event
	{
		Ongoing - Each Player;
		All;
		Mercy;
	}
	conditions
	{
		Is Using Ability 1(Event Player) == True;
		Event Player.BhopActive == True;
	}
	actions
	{
		Log To Inspector(Custom String("{0} - Mercy bunnyhop check", Event Player));
		"Ignore Crouch-GA starting crouch"
		Wait Until(!Is Crouching(Event Player) && !Is Jumping(Event Player), 99999);

		"Release GA button first"
		Wait Until( !Is Button Held(Event Player, Button(Ability 1)) || 
					!Is Using Ability 1(Event Player) || 
					Is Jumping(Event Player) || 
					Is Crouching(Event Player), 99999);
		Skip If(Is Using Ability 1(Event Player), 3);
			Skip If(Global.DebugMode < 2, 1);
			Small Message(Event Player, Custom String("Stopped using ability 1, s1, aborting"));
			Abort;
		If((Is Button Held(Event Player, Button(Jump)) && Event Player.Jump) || 
				(Is Button Held(Event Player, Button(Crouch)) && Event Player.Crouch));
			Event Player.BhopActive = False;
			Skip If(Global.DebugMode < 2, 1);
			Small Message(Event Player, Custom String("Player slinged or SJ without cancel, failing"));
			Abort;
		End;
			
		
		Wait Until(
			(Is Using Ability 1(Event Player) == False) ||
			(
				(Is Button Held(Event Player, Button(Jump)) && Event Player.Jump) || 
				(Is Button Held(Event Player, Button(Crouch)) && Event Player.Crouch)
			) == True, 99999);
		If(!Is Using Ability 1(Event Player));
			Skip If(Global.DebugMode < 2, 1);
			Small Message(Event Player, Custom String("Stopped using ability 1, s2, aborting"));
			Abort;
		Else If(!Is Button Held(Event Player, Button(Ability 1)));
			Skip If(Global.DebugMode < 2, 1);
			Small Message(Event Player, Custom String("Detected a failed bhop cancel"));
			Event Player.BhopActive = False;
		Else If(Global.DebugMode == 2);
			Small Message(Event Player, Custom String("Successful bhop cancel, dist to ground {0}", Altitude Of(Event Player)));
		End;
	}
}
