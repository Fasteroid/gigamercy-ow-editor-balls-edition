		Event Player.Resetting == False;
	}
	actions
	{
		Log To Inspector(Custom String("{0} - Detected using Secondary Fire", Event Player));

		If(Event Player.FreeMode);
			Wait(0.016, IgnoreCondition);
			Set Ability Cooldown(Event Player, Button(Secondary Fire), 0.1);
		Else;
			Set Secondary Fire Enabled(Event Player, False);
