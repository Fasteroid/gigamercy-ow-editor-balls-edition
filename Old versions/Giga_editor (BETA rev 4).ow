rule("Customization options")
{
	event
	{
		Ongoing - Global;
	}

	actions
	{
		"------Colors------"
		disabled End;
		"Start Checkpoint Ring Color. Accepts multiple Colors"
		Global.Settings[0] = Array(Color(Red));
		"Goal Checkpoint Ring Color. Accepts multiple colors"
		Global.Settings[5] = Array(Color(Aqua));
		"Goal Checkpoint text Color"
		Global.Settings[6] = Color(White);
		"Teleport pad effect color"
		Global.Settings[9] = Color(Orange);
		"Orb color"
		Global.Settings[1] = Color(Red);
		"Orb Icon Color"
		Global.Settings[12] = Color(Red);
		"Refresh Orb Color"
		Global.Settings[4] = Color(Violet);
		"Refresh Orb Icon Color"
		Global.Settings[13] = Color(Violet);
		"Anti-Orb Color"
		Global.Settings[2] = Color(Red);
		"Jump Cloud Color"
		Global.Settings[3] = Color(Red);
		"Scoreboard Top 5 colors. Accepts multiple colors"
		Global.Top5Colors = Array(Custom Color(255, 215, 0, 255), Custom Color(220, 223, 227, 255), Custom Color(191, 173, 111, 255), Custom Color(192, 192, 192, 255), Custom Color(128, 138, 135, 255), Color(White), Color(White));
		"Default Player nameplate color"
		Global.Settings[14] = Color(White);
		"Scoreboard color"
		Global.Settings[15] = Color(Red);
		"Goal effect color. Sparkles and cloud accept multiple colors"
		Global.Settings[16] = Array(Color(Red), Color(Yellow));
		"Map title color. Disable this rule if you want rainbow effect"
		disabled Global.Settings[18] = Color(Red);
		"Crouch disabled bot outline color"
		Global.Settings[19] = Color(Red);
		"Crouch enabled bot outline color"
		Global.Settings[20] = Color(Aqua);
		"Goal Icon Color"
		Global.Settings[21] = Color(Green);


		"------Texts & Icons------"
		disabled End;
		"Goal Checkpoint text"
		Global.Settings[7] = Custom String("Goal");
		"Teleport pad Text or Icon"
		Global.Settings[8] = Icon String(Spiral);
		"Player leaderboard position names"
		Global.Top5Prefix = Array(Custom String("1st"), Custom String("2nd"), Custom String("3rd"),Custom String("4th"), Custom String("5th"));
		"Scoreboard title"
		Global.Settings[17] = Custom String("Scoreboard:");
		
		"------Bot & Player Settings------"
		disabled End;
		"Player Hero"
		Global.Settings[11] = Workshop Setting Hero(Custom String("Gameplay Options"), Custom String("Player Hero"), Mercy, 0);
		"Bot Hero"
		Global.Settings[10] = Workshop Setting Hero(Custom String("Gameplay Options"), Custom String("Bot Hero"), Kiriko, 1);
		"Where to store unused bots by default"
		Global.BotPenCoords = Vector(0, 200, 0);

		"Goal Checkpoint Effect"
		Global.Settings[22] = Workshop Setting Combo(Custom String("Effects Options"), Custom String("Goal Checkpoint Effect"), 0, Array(Custom String("Light Shaft"), Custom String("Sparkles"), Custom String("Clouds")), 2);
	}
}
rule("Creator and Code")
{
	event
	{
		Ongoing - Global;
	}
	actions
	{
		"These settings wont apply if you imported data from Taw's editor"
		Abort If(Global.MapTitle != Null);
		If(Count Of(Global.CreatorAndCode) == 0);
			"Your author(s) here"
			Global.CreatorAndCode[0] = Custom String("Author");
			"Your workshop code here"
			Global.CreatorAndCode[1] = Custom String("Code");
		End;
		"Only edit this if you want a custom map title"
		Global.MapTitle = Custom String("{0} Parkour {1} by {2}", Global.Settings[11], Current Map, Custom String("{0}\nCode: {1}", Global.CreatorAndCode[0], Global.CreatorAndCode[1]));
	}
}
rule("VIPs / Custom player tags")
{
	event
	{
		Ongoing - Global;
	}
	actions
	{
		"Parkour Editor by GigaMercy"
		Global.VIPs[Count Of(Global.VIPs)] = Array(Custom String("GigaMercy"), Custom String("{0}GigaMercy", Ability Icon String(Hero(Mercy), Button(Ability 1))), Custom Color(251, 134, 28, 224));
		"Add your custom names here\n[0]: BNet name\n[1]: Custom name\n[2]: Color/Custom Color"
		Global.VIPs[Count Of(Global.VIPs)] = Array(Custom String(""), Custom String(""), Color(White));
		Global.VIPs[Count Of(Global.VIPs)] = Array(Custom String(""), Custom String(""), Color(White));
		Global.VIPs[Count Of(Global.VIPs)] = Array(Custom String(""), Custom String(""), Color(White));
	}
}
rule("———————————————————Initialization Settings———————————————————")
{
	event
	{
		Ongoing - Global;
	}
}
rule("1. Global Initialization")
{
	event
	{
		Ongoing - Global;
	}
	actions
	{
		Call Subroutine(InitializeGlobalVariables);
		Skip If(Global.DebugMode, 1);
			Disable Inspector Recording;
		Disable Built-In Game Mode Announcer;
		Disable Built-In Game Mode Completion;
		Disable Built-In Game Mode Music;
		Disable Built-In Game Mode Scoring;
		Disable Built-In Game Mode Respawning(All Players(All Teams));		
		Pause Match Time;
		"TODO: useless right?"
		disabled Stop Forcing Spawn Room(All Teams);
		
		"Decompress data"
		If(Global.MapData);
			Call Subroutine(DecompressMapData);
		"Detect Taw's Editor data"
		Else If (Global.TawsCompressedData);
			Call Subroutine(TawsDecompressData);
		Else If (Global.PeaceCheckpoint || Global.PeaceCheckpoint2);
			If(Global.PeaceCheckpoint2 == True);
				Global.PeaceCheckpoint = Global.PeaceCheckpoint2;
				Global.PeaceCheckpoint2 = Null;
			End;
			Call Subroutine(PeaceDecompressData);
		End;
		Log To Inspector(Custom String("Decompression ended"));
		Wait(0.016, Ignore Condition);
		If(Global.EditMode);
			Call Subroutine(InitializeEditModeVariables);
			Wait(0.016, Ignore Condition);
			Call Subroutine(CreateGlobalEditModeHUD);
			Wait(0.016, Ignore Condition);
		End;
	}
}
rule("2. Player Initialization")
{
	event
	{
		Player Joined Match;
		All;
		All;
	}

	conditions
	{
		Is Dummy Bot(Event Player) == False;
	}

	actions
	{
		Event Player.Finished = True;
		Log To Inspector(Custom String("{0} - Joined match", Event Player));
		Wait Until(Has Spawned(Event Player), 99999);
		Log To Inspector(Custom String("Initializing player {0}...", Event Player));
		Start Forcing Player To Be Hero(Event Player, Global.Settings[11]);
		Disable Game Mode HUD(Event Player);
		Disable Game Mode In-World UI(Event Player);
		"// TODO: Check if needed"
		Enable Death Spectate All Players(Event Player);
		Enable Death Spectate Target HUD(Event Player);
		Disable Nameplates(Event Player, All Players(All Teams));
		Disable Movement Collision With Players(Event Player);
		
		"Disable me if you need spawn room walls in your map (Assault/Hybrid/Escort maps only)"
		Start Forcing Spawn Room(Team 1, Color(Red));
		Start Forcing Spawn Room(Team 2, Color(Red));


		Disable Movement Collision With Players(Event Player);
		
		
		Disable Movement Collision With Players(Event Player);
		
		Wait(0.016, Ignore Condition);
		Call Subroutine(InitializePlayerVariables);
		Call Subroutine(CreatePlayerHUD);
		If(Global.EditMode || Is True for Any(Global.Bots, Current Array Element == True));
			Call Subroutine(InitializePlayerBot);
		End;
		Wait(0.016, Ignore Condition);
		Call Subroutine(TeleportToCurrentCheckpoint);
		Call Subroutine(SetUpCheckpoint);
		
		If(Global.EditMode);
			Call Subroutine(CreatePlayerEditModeHUD);
			Call Subroutine(EnableAllAbilities);
		End;
		If(Global.DebugMode == 2); 
			Call Subroutine(CreatePlayerDebugModeHUD);
		End;
		Wait(0.032, Ignore Condition);
		Skip If(Global.Checkpoints[Event Player.Checkpoint][2], 1);
		Set Facing(Event Player, Direction Towards(Position Of(Event Player), Event Player.GoalCoords), To World);
		Event Player.FreeMode = Count Of(Global.Checkpoints) < 0 || Global.EditMode;
		Log To Inspector(Custom String("{0} - Initialization Done", Event Player));
	}
}
rule("3. Set player Invincible")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Has Status(Event Player, Invincible) == False;
	}
	actions
	{
		Set Status(Event Player, Null, Invincible, 99999);
	}
}
rule("—————————————————————Controls——————————————————————")
{
	event
	{
		Ongoing - Global;
	}
}
rule("Press [Interact] twice to view/hide controls | EditMode: Open menu")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
	}
	actions
	{
		Abort If(Is True For Any(Remove From Array(Global.ButtonList, Array(Button(Interact), Button(Jump), Button(Crouch))), Is Button Held(Event Player, Current Array Element)));
		Wait Until(!Is Button Held(Event Player, Button(Interact)), 99999);
		Wait Until(Is Button Held(Event Player, Button(Interact)), 0.200);
		"These buttons create/destroy objects, we dont want to open menu during those events"
		Abort If(Is True For Any(Array(Button(Primary Fire), Button(Secondary Fire)), Is Button Held(Event Player, Current Array Element)));
		If(Is Button Held(Event Player, Button(Interact)));
			Skip If(Global.EditMode, 6);
			If(!Array Contains(Global.ShowSidebarControlsPlayers, Event Player));
				Modify Global Variable(ShowSidebarControlsPlayers, Append To Array, Event Player);
			Else;
				Modify Global Variable(ShowSidebarControlsPlayers, Remove From Array By Value, Event Player);
			End;
			Abort;
			Log To Inspector(Custom String("{0} - Toggle menu", Event Player));
			"For safety"
			disabled Event Player.PaletteOpen = False;
			Event Player.MenuOpen = !Event Player.MenuOpen;
			"Cleanup edit number"
			Event Player.EditNumber = Null;
			If(Event Player.MenuOpen);
				Set Move Speed(Event Player, 0);
				Set Jump Enabled(Event Player, False);
			Else;
				Set Move Speed(Event Player, 100);
				Set Jump Enabled(Event Player, Event Player.FreeMode ? True : Event Player.Jump);
			End;
			Set Primary Fire Enabled(Event Player, !Event Player.MenuOpen);
			Set Secondary Fire Enabled(Event Player, !Event Player.MenuOpen);
			Call Subroutine(GetEditMenuTempData);
		End;
	}
}
rule("Press [Interact] + [Melee] + [Primary/Secondary Fire] to switch checkpoints | EditMode: Switch object mode")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Button Held(Event Player, Button(Interact)) == True;
		Is Button Held(Event Player, Button(Melee)) == True;
		Is Button Held(Event Player, Button(Primary Fire)) !=
		Is Button Held(Event Player, Button(Secondary Fire));
	}
	actions
	{
		Event Player.MenuOpen = False;
		Event Player.TempFreeMode = Event Player.FreeMode;
		Event Player.FreeMode = True;
		Event Player.Checkpoint = Is Button Held(Event Player, Button(Primary Fire)) ? 
			(Event Player.Checkpoint + 1 ) % Count Of(Global.Checkpoints) : 
			(Event Player.Checkpoint - 1 + Count Of(Global.Checkpoints)) % Count Of(Global.Checkpoints);
			
		Call Subroutine(TeleportToCurrentCheckpoint);
		Event Player.FreeMode = Event Player.TempFreeMode;
		Log To Inspector(Custom String("{0} - Switched manually to CP {1}", Event Player, Event Player.Checkpoint));
		Call Subroutine(SetUpCheckpoint);
		"Hold buttons to speed switch"
		Wait(0.2, Abort When False);
		Loop If Condition Is True;
	}
}
rule("Press [Reload] to reset current checkpoint")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Button Held(Event Player, Button(Reload)) == True;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
	}
	actions
	{
		Wait(0.016, Ignore Condition);
		Abort If(Is True For Any(Remove From Array(Global.ButtonList, Button(Reload)), Is Button Held(Event Player, Current Array Element)));
		"Sometimes going into free mode triggered this rule, if the keys were released in a specific order"
		disabled If(Is Button Held(Event Player, Button(Interact)) == True || Is Button Held(Event Player, Button(Melee)) == True);
		disabled	Abort;
		disabled End;
		Call Subroutine(TeleportToCurrentCheckpoint);
		If(Event Player.LeftCheckpoint && Event Player.FreeMode == False);
			Call Subroutine(ResetWithMistake);
		Else;
			Call Subroutine(ResetCheckpoint);
		End;
	}
}
rule("Press [Crouch] + [Interact] + [Ability 2] to restart run")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Button Held(Event Player, Button(Crouch)) == True;
		Is Button Held(Event Player, Button(Interact)) == True;
		Is Button Held(Event Player, Button(Ability 2)) == True;
	}
	actions
	{
		Abort If(Is True For Any(Remove From Array(Global.ButtonList, Array(Button(Crouch), Button(Interact), Button(Ability 2), Button(Jump))), Is Button Held(Event Player, Current Array Element)));
		Play Effect(Event Player, Tracer Recall Disappear Sound, Null, Event Player, 100);
		Event Player.Mistakes = 0;
		Event Player.FreeMode = True;
		If(Is Using Ultimate(Event Player));
			Call Subroutine(CancelUltimate);
		End;
		"Anti abuse measure"
		If(Event Player.Checkpoint == 0);
			Call Subroutine(TeleportToCurrentCheckpoint);
			Event Player.FreeMode = False;
			Call Subroutine(ResetCheckpoint);
		Else;
			Event Player.Checkpoint = 0;
			Call Subroutine(TeleportToCurrentCheckpoint);
			Event Player.FreeMode = False;
			Call Subroutine(SetUpCheckpoint);
		End;
		Wait(1, Ignore Condition);
	}
}
rule("Press [Reload] + [Jump] to toggle 3rd person camera")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Button Held(Event Player, Button(Reload)) == True;
		Is Button Held(Event Player, Button(Jump)) == True;
	}
	actions
	{
		Abort If(Is True For Any(Remove From Array(Global.ButtonList, Array(Button(Reload), Button(Jump))), Is Button Held(Event Player, Current Array Element)));
		"By overclocking"
		Wait(0.750, Abort When False);
		Event Player.ThirdPerson = !Event Player.ThirdPerson;
		Skip If(Event Player.ThirdPerson, 2);
		Stop Camera(Event Player);
		Abort;
		Start Camera(Event Player, Ray Cast Hit Position(Event Player + Up * (Distance Between(Eye Position(Event Player), Event Player)
			+ 0.500), Ray Cast Hit Position(Event Player + Up * (Distance Between(Eye Position(Event Player), Event Player) + 0.500),
			Event Player + Up * (Distance Between(Eye Position(Event Player), Event Player) + 0.500) + Facing Direction Of(Event Player)
			* -3, Null, Event Player, True), Null, Event Player, True), Event Player + Facing Direction Of(Event Player) * 100, 0);
	}
}
rule("Press [Interact] to TP to player (Free Mode only)")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.FreeMode == True;
		Is Button Held(Event Player, Button(Interact)) == True;
	}
	actions
	{
		Abort If(Is True For Any(Remove From Array(Global.ButtonList, Array(Button(Interact))), Is Button Held(Event Player, Current Array Element)));
		
		Abort If(Is Dummy Bot(Player Closest To Reticle(Event Player, Team(All))) || !Is In View Angle(Event Player, Player Closest To Reticle(Event Player, All Teams), 10));
		Teleport(Event Player, Player Closest To Reticle(Event Player, Team(All)));
	}
}
rule("Press [Ultimate] + [Ability 2] to toggle spectator mode")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{		
		Is Dummy Bot(Event Player) == False;
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Is Button Held(Event Player, Button(Ability 2)) == True;
	}
	actions
	{
		Wait(1, Abort When False);
		Abort If(Is True For Any(Remove From Array(Global.ButtonList, Array(Button(Ultimate), Button(Ability 2))), Is Button Held(Event Player, Current Array Element)));
		Event Player.SpectatorMode = !Event Player.SpectatorMode;

		If(!Event Player.SpectatorMode);
			Resurrect(Event Player);
			Call Subroutine(ResetCheckpoint);
			Enable Built-In Game Mode Respawning(Event Player);
		Else;
			Stop Chasing Player Variable(Event Player, CurrentRunTime);
			Disable Built-In Game Mode Respawning(Event Player);
			Kill(Event Player, Null);
		End;
	}
}
rule("Press [Interact] + [Reload] to toggle Free Mode")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Is Button Held(Event Player, Button(Interact)) == True;
		Is Button Held(Event Player, Button(Reload)) == True;
	}
	actions
	{
		Abort If(Is True For Any(Remove From Array(Global.ButtonList, Array(Button(Interact), Button(
		Reload), Button(Jump), Button(Crouch))), Is Button Held(Event Player, Current Array Element)));
		If(Event Player.FreeMode);
			Skip If(Event Player.Collision, 1);
			Call Subroutine(TogglePlayerCollision);
			Call Subroutine(TeleportToCurrentCheckpoint);
			If(Is Using Ultimate(Event Player));
				Call Subroutine(CancelUltimate);
			End;
			Event Player.FreeMode = False;
			Call Subroutine(ResetCheckpoint);
		Else;
			Call Subroutine(EnableAllAbilities);
			"// TODO: Move to subroutine setcurrentabilities?"
			Event Player.FreeMode = True;
			Call Subroutine(ResetCheckpoint);
			Stop Chasing Player Variable(Event Player, CurrentRunTime);
		End;
		Small Message(Event Player, Event Player.FreeMode ? Custom String("Free mode enabled") : Custom String("Free mode disabled"));
		Wait(0.600, Ignore Condition);
	}
}
rule("Hold [Interact] + [Ultimate] to cancel ultimate (Free Mode only)")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.FreeMode == True;
		Is Using Ultimate(Event Player) == True;
		Is Button Held(Event Player, Button(Ultimate)) == True;
		Is Button Held(Event Player, Button(Interact)) == True;
	}
	actions
	{
		Abort If(Is True For Any(Remove From Array(Global.ButtonList, Array(Button(Ultimate), Button(Interact), Button(Jump))), Is Button Held(Event Player, Current Array Element)));
		Wait Until(!Is Button Held(Event Player, Button(Ultimate)), 99999);
		Call Subroutine(CancelUltimate);
		"Anti Abuse wait"
		Wait(1, Ignore Condition);
	}
}
rule("Subroutine: TogglePlayerCollision")
{
	event
	{
		Subroutine;
		TogglePlayerCollision;

	}
	actions
	{
		If(Event Player.Collision && !Event Player.FreeMode);
			Small Message(Event Player, Custom String("Cant disable collision outside of free mode"));
			Abort;
		End;
		Event Player.Collision = !Event Player.Collision;
		If(Event Player.Collision);
			Enable Movement Collision with Environment(Event Player);
		Else;
			Disable Movement Collision with Environment(Event Player, False);
		End;
		Small Message(Event Player, Custom String("Collision with environment {0}", Event Player.Collision ? Custom String("Enabled") : Custom String("Disabled")));
	}
}
rule("—————————————————————Effects———————————————————————")
{
	event
	{
		Ongoing - Global;
	}
}
rule("Create Start and Finish checkpoints")
{
	event
	{
		Player Joined Match;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;	
	}
	actions
	{
		Wait Until(Has Spawned(Event Player), 99999);
		"Create start checkpoint Ring"
		For Player Variable(Event Player, j, 0, Count Of(Global.Settings[0]), 1);
			Create Effect(Event Player, Ring, Global.Settings[0][Evaluate Once(Event Player.j)], Global.Checkpoints[Event Player.Checkpoint][0], Global.Checkpoints[Event Player.Checkpoint][1] - Evaluate Once(Event Player.j*0.2), Visible To Position Radius and Color);
		End;
		"Create Goal checkpoint Ring"
		For Player Variable(Event Player, j, 0, Count Of(Global.Settings[5]), 1);
			Create Effect(Global.Checkpoints[Event Player.Checkpoint + 1 ] ? Event Player : Null, Ring, Global.Settings[5][Evaluate Once(Event Player.j)], Event Player.GoalCoords, Event Player.GoalRadius - Evaluate Once(Event Player.j*0.2), Visible To Position Radius and Color);
		End;
		"Create Goal checkpoint Icon"
		Create Icon(Global.Checkpoints[Event Player.Checkpoint + 1 ] && !Global.Teleports[Event Player.Checkpoint] ? Event Player : Null, Event Player.GoalCoords + Vector(0, 1.500, 0), Flag, Visible To Position and Color, Global.Settings[21], True);
		"Enable this instead if you want an ability icon on the goal"
		disabled Create In-World Text(Global.Checkpoints[Event Player.Checkpoint + 1 ] && !Global.Teleports[Event Player.Checkpoint] ? Event Player : Null, 
		Ability Icon String(Hero(Brigitte), Button(Ultimate)), Event Player.GoalCoords + Vector(0, 1.5, 0), 
		2,
		Do Not Clip, Visible To and Position, Global.Settings[21], 
		Default Visibility);
		"Create Goal checkpoint Text"
		Create In-World Text(Global.Checkpoints[Event Player.Checkpoint + 1] ? Event Player : Null, Global.Teleports[Event Player.Checkpoint] ? Global.Settings[8] : Global.Settings[7], Event Player.GoalCoords + Vector(0, 0.5, 0), 1.5, Do Not Clip, Visible To Position and String, Global.Settings[6], Default Visibility);
		"Create Goal checkpoint effects"
		For Player Variable(Event Player, j, 0, Count Of(Global.Settings[16]), 1);
			Skip(Global.Settings[22] * 2);
			Create Effect(Global.Checkpoints[Event Player.Checkpoint + 1 ] ? Event Player : Null, Light Shaft, Evaluate Once(Global.Settings[16][Event Player.j]), Event Player.GoalCoords, Event Player.GoalRadius, Visible To Position Radius and Color);
			Abort;
			Create Effect(Global.Checkpoints[Event Player.Checkpoint + 1 ] ? Event Player : Null, Sparkles, Evaluate Once(Global.Settings[16][Event Player.j]), Event Player.GoalCoords, Event Player.GoalRadius, Visible To Position Radius and Color);
			Continue;
			Create Effect(Global.Checkpoints[Event Player.Checkpoint + 1 ] ? Event Player : Null, Cloud, Evaluate Once(Global.Settings[16][Event Player.j]), Event Player.GoalCoords, Event Player.GoalRadius, Visible To Position Radius and Color);
			Continue;
		End;
	}
}
rule("Create/Destroy current level Orbs")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;

	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Count Of(Event Player.OrbEffects) != Count Of(Global.Orbs[Event Player.Checkpoint]);	
		Event Player.OrbEffects != Null;
	}
	actions
	{
		If(Count Of(Event Player.OrbEffects) > Count Of(Global.Orbs[Event Player.Checkpoint]));
			Destroy Effect(Last Of(Event Player.OrbEffects));
			Modify Player Variable(Event Player, OrbEffects, Remove from Array By Index, Count Of(Event Player.OrbEffects) - 1);
			Wait(0.016, Ignore Condition);
			Destroy Icon(Last Of(Event Player.OrbIcons));
			Modify Player Variable(Event Player, OrbIcons, Remove from Array By Index, Count Of(Event Player.OrbIcons) - 1);
		Else;
			"Action: Create orb effect"
			If(Global.OrbStyle == 1);
				Create Effect(
				Event Player.GrabbedOrbs[Evaluate Once(Count Of(Event Player.OrbEffects))] ? Null : Event Player, Orb, Global.Settings[1], 
				Global.Orbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.OrbEffects))][0], 
				Global.Orbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.OrbEffects))][1], 
				Visible To Position Radius and Color);
			Else;
				Create Effect(
				Event Player.GrabbedOrbs[Evaluate Once(Count Of(Event Player.OrbEffects))] ? Null : Event Player, Sphere, Global.Settings[1], 
				Global.Orbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.OrbEffects))][0], 
				Global.Orbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.OrbEffects))][1], 
				Visible To Position Radius and Color);
			End;
			"Save reference for last created orb to player variable"		
			Modify Player Variable(Event Player, OrbEffects, Append To Array, Last Created Entity);
			
			Wait(0.016, Ignore Condition);
			"Action: Create orb icon"
			Create Icon(Event Player.GrabbedOrbs[Evaluate Once(Count Of(Event Player.OrbIcons))] ? Null : Event Player, 
			Global.Orbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.OrbIcons))][0] 
				+ Vector(0,Global.Orbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.OrbIcons))][1]/2, 0), 
			Circle, Visible To and Position, Global.Settings[12], True);
			"Save reference for last created icon to player variable"		
			Modify Player Variable(Event Player, OrbIcons, Append To Array, Last Created Entity);
		End;
		Wait(0.016, Ignore Condition);
		Loop If Condition Is True;
	}
}
rule("Create/Destroy current level RefreshOrbs")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;

	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Count Of(Event Player.RefreshOrbEffects) != Count Of(Global.RefreshOrbs[Event Player.Checkpoint]);	
		Event Player.RefreshOrbEffects != Null;
	}
	actions
	{
		"// TODO: Implement Taw's/Peace editor switch to reuse a single refresh orb or render all"
		If(Count Of(Event Player.RefreshOrbEffects) > Count Of(Global.RefreshOrbs[Event Player.Checkpoint]));
			Destroy Effect(Last Of(Event Player.RefreshOrbEffects));
			Modify Player Variable(Event Player, RefreshOrbEffects, Remove from Array By Index, Count Of(Event Player.RefreshOrbEffects) - 1);
			Wait(0.016, Ignore Condition);
			Destroy Icon(Last Of(Event Player.RefreshOrbIcons));
			Modify Player Variable(Event Player, RefreshOrbIcons, Remove from Array By Index, Count Of(Event Player.RefreshOrbIcons) - 1);
		Else;
			If(Global.RefreshOrbStyle == 1);
				Create Effect(Event Player.GrabbedRefreshOrbs[Evaluate Once(Count Of(Event Player.RefreshOrbEffects))] ? Null : Event Player, 
				Orb, Global.Settings[4], 
				Global.RefreshOrbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.RefreshOrbEffects))][0], 
				Global.RefreshOrbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.RefreshOrbEffects))][1], 
				Visible To Position Radius and Color);
			"Save reference for last created RefeshOrb to player variable"		
			Modify Player Variable(Event Player, RefreshOrbEffects, Append To Array, Last Created Entity);
			Else If(Global.RefreshOrbStyle == 2);
				Create Effect(Event Player.GrabbedRefreshOrbs[Evaluate Once(Count Of(Event Player.RefreshOrbEffects))] ? Null : Event Player, 
				Sphere, Global.Settings[4], 
				Global.RefreshOrbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.RefreshOrbEffects))][0], 
				Global.RefreshOrbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.RefreshOrbEffects))][1], 
				Visible To Position Radius and Color);
			"Save reference for last created RefeshOrb to player variable"		
			Modify Player Variable(Event Player, RefreshOrbEffects, Append To Array, Last Created Entity);
			Else;
				Create Effect(Event Player.GrabbedRefreshOrbs[Evaluate Once(Count Of(Event Player.RefreshOrbEffects))] ? Null : Event Player, 
				Cloud, Global.Settings[4], 
				Global.RefreshOrbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.RefreshOrbEffects))][0], 
				Global.RefreshOrbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.RefreshOrbEffects))][1], 
				Visible To Position Radius and Color);
				Event Player.Temp = Last Created Entity;
				Create Effect(Event Player.GrabbedRefreshOrbs[Evaluate Once(Count Of(Event Player.RefreshOrbEffects))] ? Null : Event Player, 
				Sparkles, Global.Settings[4], 
				Global.RefreshOrbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.RefreshOrbEffects))][0], 
				Global.RefreshOrbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.RefreshOrbEffects))][1], 
				Visible To Position Radius and Color);
				"Save reference for last created RefeshOrb to player variable"		
				Modify Player Variable(Event Player, RefreshOrbEffects, Append To Array, Array(Array(Event Player.Temp, Last Created Entity)));
			End;
			
			Wait(0.016, Ignore Condition);
			"Action: Create RefeshOrb icon"
			Create Icon(Event Player.GrabbedRefreshOrbs[Evaluate Once(Count Of(Event Player.RefreshOrbIcons))] ? Null : Event Player, 
			Global.RefreshOrbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.RefreshOrbIcons))][0]
				+ Vector(0, Global.RefreshOrbs[Event Player.Checkpoint][Evaluate Once(Count Of(Event Player.RefreshOrbIcons))][1]/2, 0), 
			Recycle, Visible To and Position, Global.Settings[13], True);
			"Save reference for last created icon to player variable"		
			Modify Player Variable(Event Player, RefreshOrbIcons, Append To Array, Last Created Entity);
		End;
		Wait(0.016, Ignore Condition);
		Loop If Condition Is True;
	}
}
