rule("Create Start and Finish checkpoints")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Has Spawned(Event Player) == True;
		Is Dummy Bot(Event Player) == False;	
	}
	actions
	{
		"Create start checkpoint Ring"
		Create Effect(Event Player, Ring, Global.Settings[0], Global.Checkpoints[Event Player.Checkpoint][0], 
		Global.Checkpoints[Event Player.Checkpoint][1], Visible To Position Radius and Color);
		"Create Goal checkpoint Ring"
		Create Effect(Global.Checkpoints[Event Player.Checkpoint + 1 ] ? Event Player : Null, Ring, Global.Settings[5], Event Player.GoalCoords, Event Player.GoalRadius, Visible To Position Radius and Color);
		"Create Goal checkpoint Sparkles"
		Create Effect(Global.Checkpoints[Event Player.Checkpoint + 1 ] ? Event Player : Null, Sparkles, Global.Settings[5], Event Player.GoalCoords, Event Player.GoalRadius, Visible To Position Radius and Color);
		"Create Goal checkpoint Icon"
		Create Icon(Global.Checkpoints[Event Player.Checkpoint + 1 ] && !Global.Teleports[Event Player.Checkpoint] ? Event Player : Null, Event Player.GoalCoords + Vector(0, 2, 0), Flag, Visible To Position and Color, Global.Settings[21], True);
		"Create Goal checkpoint Text"
		Create In-World Text(Global.Checkpoints[Event Player.Checkpoint + 1] ? Event Player : Null, Global.Teleports[Event Player.Checkpoint] ? Global.Settings[8] : Global.Settings[7], Event Player.GoalCoords + Vector(0, 1, 0), 1.5, Do Not Clip, Visible To Position and String, Global.Settings[6], Default Visibility);
	}
}
rule("Create Bot Icon")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Has Spawned(Event Player) == True;
		Is Dummy Bot(Event Player) == False;
		Event Player.Bot == True;
	}
	actions
	{
		"Create Bot Icon"
		Create Icon(Global.Bots[Event Player.Checkpoint] ? Event Player : Null, 
		Eye Position(Event Player.Bot) + Vector(0, 0.5, 0), 
		Arrow: Down, 
		Visible To Position and Color, 
		Global.Checkpoints[Event Player.Checkpoint][3] ? Color(Aqua) : Color(Red), 
		True);
		Modify Player Variable(Event Player, BotIcons, Append To Array, Last Created Entity);
	}
}
rule("Create Teleport Effects")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Has Spawned(Event Player) == True;
		Is Dummy Bot(Event Player) == False;
	}
	actions
	{
		"For now we assume theres only one teleport pad per level, no need for multiple effect handling"
		Create Effect(Global.Teleports[Event Player.Checkpoint] ? Event Player : Null,
		Sparkles,
		Global.Settings[9],
		Global.Teleports[Event Player.Checkpoint][0],
		Global.Teleports[Event Player.Checkpoint][1],
		Visible To Position Radius and Color);
	}
}
rule("Calculate rainbow")
{
	event
	{
		Ongoing - Global;
	}
	conditions
	{
		GLobal.DebugMode == False;
	}
	actions
	{
		While(Global.RGB[1] < 255);
			Global.RGB[1] += 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[2] > 0);
			Global.RGB[2] -= 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[0] < 255);
			Global.RGB[0] += 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[1] > 0);
			Global.RGB[1] -= 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[2] < 255);
			Global.RGB[2] += 3;
			Wait(0.016, Ignore Condition);
		End;
		While(Global.RGB[0] > 0);
			Global.RGB[0] -= 3;
			Wait(0.016, Ignore Condition);
		End;
		Loop;
	}
}
rule("——————————————————————————Parkour Engine rules——————————————————————————")
{
	event
	{
		Ongoing - Global;
	}
}

rule("Detect Leaving checkpoint")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
		Distance Between(Event Player, Global.Checkpoints[Event Player.Checkpoint][0]) 
		> Global.Checkpoints[Event Player.Checkpoint][1];
	}
	actions
	{
		Event Player.LeftCheckpoint = True;
		Chase Player Variable At Rate(Event Player, CurrentRunTime, 20000, 1, Destination and Rate);
	}
}
rule("Detect Landing Outside")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
		Is On Ground(Event Player) == True;
		Distance Between(Event Player, Global.Checkpoints[Event Player.Checkpoint][0]) 
		> Global.Checkpoints[Event Player.Checkpoint][1];
	}
	actions
	{
		Abort If(Distance Between(Event Player, Event Player.GoalCoords) <= Event Player.GoalRadius &&
		((Y Component Of(Position Of(Event Player)) <= (Y Component Of(Event Player.GoalCoords) + Event Player.GoalThresholds[0])) &&
		(Y Component Of(Position Of(Event Player)) >= Y Component Of(Event Player.GoalCoords) - Event Player.GoalThresholds[1])) == True);

		If(Event Player.Checkpoint == 0);
			Stop Chasing Player Variable(Event Player, CurrentRunTime);
			Event Player.CurrentRunTime = 0;
		End;

		"Too Annoying"
		disabled Small Message(Event Player, Custom String("You need to land inside the Goal!"));
		disabled Play Effect(Event Player, Debuff Impact Sound, Null, Event Player, 100);
		Call Subroutine(ResetWithMistake);
	}
}
rule("Detect Arriving on Goal or Teleport")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
		Event Player.LeftCheckpoint == True;

		"TODO: Get OnGround flag from current goal in case the level has a teleport"
		((Global.Checkpoints[Event Player.Checkpoint + 1][4] && Is On Ground(Event Player)) ||
		!Global.Checkpoints[Event Player.Checkpoint + 1][4]) == True;
		Distance Between(Event Player, Event Player.GoalCoords) <= Event Player.GoalRadius;
		((Y Component Of(Position Of(Event Player)) <= Y Component Of(Event Player.GoalCoords) + Event Player.GoalThresholds[0]) &&
		(Y Component Of(Position Of(Event Player)) >= Y Component Of(Event Player.GoalCoords) - Event Player.GoalThresholds[1])) == True;
	}
	actions
	{
		If(Is True For Any(Event Player.GrabbedOrbs, Current Array Element == False) && (Count Of(Event Player.GrabbedOrbs) > 0));
			Small Message(Event Player, Custom String("You need to grab all the orbs!"));
			Play Effect(Event Player, Debuff Impact Sound, Null, Event Player, 100);
			Call Subroutine(ResetWithMistake);
		Else If(Is True For Any(Event Player.GrabbedRefreshOrbs, Current Array Element == False) && (Count Of(Event Player.GrabbedRefreshOrbs) > 0) && Global.RequireGrabAllRefreshOrbs);
			Small Message(Event Player, Custom String("You need to grab all the refresh orbs!"));
			Play Effect(Event Player, Debuff Impact Sound, Null, Event Player, 100);
			Call Subroutine(ResetWithMistake);
		Else If(Global.Bots[Event Player.Checkpoint] && !Event Player.BotCondition);
			Small Message(Event Player, Custom String("You need to rez the bot!"));
			Play Effect(Event Player, Debuff Impact Sound, Null, Event Player, 100);
			Call Subroutine(ResetWithMistake);
		Else;
			Event Player.Checkpoint += 1;
			"Player finished all checkpoints"
			If(Event Player.Checkpoint == Count Of(Global.Checkpoints) - 1);
				Stop Chasing Player Variable(Event Player, CurrentRunTime);
				Event Player.FreeMode = True;
				"TODO: Consider not duplicating this block if possible"
				If(Global.Teleports[Event Player.Checkpoint - 1]);
					Call Subroutine(TeleportToCurrentCheckpoint);
					Play Effect(Event Player, Sombra Translocator Reappear Sound, Null, Event Player, 100);
				End;
				Call Subroutine(EnableAllAbilities);
				Play Effect(All Players(All Teams), Ring Explosion Sound, Null, Event Player, 100);
				"TODO: Set a color for finish explosion in config"
				Play Effect(All Players(All Teams), Good Pickup Effect, Color(Aqua), Global.Checkpoints[Event Player.Checkpoint][0], Global.Checkpoints[Event Player.Checkpoint][1]);
				Wait(0.1, Ignore Condition);
				Big Message(All Players(All Teams), Custom String("{0} Finished in {1} seconds", Event Player.PlayerName, Event Player.CurrentRunTime));
				Call Subroutine(PlayerCompletedRun);
			"Player finished current checkpoint"
			Else;
				Small Message(Event Player, Custom String("Reached the goal:D"));
				If(Global.Teleports[Event Player.Checkpoint - 1]);
					"TODO: This broke jazzy's hanamura lvl 98 to 99, it cancels momentum so for now we teleport the player manually"
					disabled Call Subroutine(TeleportToCurrentCheckpoint);
					Call Subroutine(CancelMomentum);
					Teleport(Event Player, Global.Checkpoints[Event Player.Checkpoint][0]);
					Play Effect(Event Player, Sombra Translocator Reappear Sound, Null, Event Player, 100);
				End;
					Play Effect(Event Player, Buff Explosion Sound, Null, Event Player, 100);
			End;
			Call Subroutine(SetUpCheckpoint);
		End;
	}
}
rule("Detect Grabbing Orb")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
		Count Of(Event Player.GrabbedOrbs) > 0;
		
		Is True For Any(Global.Orbs[Event Player.Checkpoint], 
		!Event Player.GrabbedOrbs[Current Array Index] && 
		(Distance Between(Position Of(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700 ||
		Distance Between(Eye Position(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700))
		== True;
	}
	actions
	{
		If(Event Player.BotCondition || True);
			Event Player.GrabbedOrbs = Mapped Array(Global.Orbs[Event Player.Checkpoint],
				Distance Between(Position Of(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700 ||
				Distance Between(Eye Position(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700
				|| Event Player.GrabbedOrbs[Current Array Index] ? True : False);
			Small Message(Event Player, Custom String("Orb Grab! {0}/{1}",
			Count Of(Filtered Array(Event Player.GrabbedOrbs, Current Array Element == True)),
			Count Of(Event Player.GrabbedOrbs)));
			Play Effect(Event Player, Buff Impact Sound, Null, Event Player, 100);
		Else;
			Small Message(Event Player, Custom String("You need to rez the bot!"));
			Call Subroutine(ResetWithMistake);
		End;
	}
}
rule("Detect Grabbing RefreshOrb")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
		Count Of(Event Player.GrabbedRefreshOrbs) > 0;
		
		Is True For Any(Global.RefreshOrbs[Event Player.Checkpoint], 
		!Event Player.GrabbedRefreshOrbs[Current Array Index] && 
		(Distance Between(Position Of(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700 ||
		Distance Between(Eye Position(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700))
		== True;
	}
	actions
	{
		If(Event Player.BotCondition);
			For Player Variable(Event Player, i, 0, Count Of(Event Player.GrabbedRefreshOrbs), 1);
				If(!Event Player.GrabbedRefreshOrbs[Event Player.i] &&
				(Distance Between(Position Of(Event Player), Global.RefreshOrbs[Event Player.i][0]) <= Global.RefreshOrbs[Event Player.i][1] + 0.700 ||
				Distance Between(Eye Position(Event Player), Global.RefreshOrbs[Event Player.i][0]) <= Global.RefreshOrbs[Event Player.i][1] + 0.700));

					Event Player.GrabbedRefreshOrbs[Event Player.i] = True;
					Small Message(Event Player, 
					Custom String("Orb Grab! {0}/{1}, {2} also refreshed!",
						Count Of(Filtered Array(Event Player.GrabbedRefreshOrbs, Current Array Element == True)),
						Count Of(Event Player.GrabbedRefreshOrbs),
						Custom String("{0}{1}{2}", 
							Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][3] ? Ability Icon String(Hero Of(Event Player), Button(Ability 1)) : Empty Array,
							Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][4] ? Ability Icon String(Hero Of(Event Player), Button(Ability 2)) : Empty Array,
							Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][5] ? Ability Icon String(Hero Of(Event Player), Button(Ultimate)) : Empty Array
						)
					));
					Play Effect(Event Player, Buff Impact Sound, Null, Event Player, 100);
					"Trigger Bot Section"
					If(Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][2]);
						Event Player.CurrentBotSection = Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][2];
						Set Player Variable(Event Player.Bot, CurrentBotSection, Event Player.CurrentBotSection);
						Call Subroutine(UpdateBotPosition);
					End;
					Event Player.Ability1 = Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][3] ? True : Event Player.Ability1;
					Set Ability 1 Enabled(Event Player, Event Player.Ability1);
					Event Player.Ability2 = Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][4] ? True : Event Player.Ability2;					
					Set Ability 2 Enabled(Event Player, Event Player.Ability2);
					Event Player.Ultimate = Global.RefreshOrbs[Event Player.Checkpoint][Event Player.i][3] ? True : Event Player.Ultimate;					
					Set Ultimate Ability Enabled(Event Player, Event Player.Ultimate);
				End;
		Else;
			Small Message(Event Player, Custom String("You need to rez the bot!"));
			Call Subroutine(ResetWithMistake);
		End;
	}
}
rule("Detect Touching AntiOrb")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
		Global.AntiOrbs[Event Player.Checkpoint] == True;
		
		Is True For Any(Global.AntiOrbs[Event Player.Checkpoint], 
		(Distance Between(Position Of(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700 ||
		Distance Between(Eye Position(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.700))
		== True;
	}
	actions
	{
		Set Status(Event Player, Null, Burning, 0.16);
		Call Subroutine(ResetWithMistake);
	}
}
rule("Detect Touching Jump Cloud")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.Finished == False;
		Event Player.FreeMode == False;
		Global.Clouds[Event Player.Checkpoint] == True;
		
		Is True For Any(Global.Clouds[Event Player.Checkpoint], 
		(Distance Between(Position Of(Event Player), Current Array Element[0])  <= Current Array Element[1] + 0.500 &&
		Absolute Value(Y Component Of(Current Array Element[0]) - Y Component Of(Position Of(Event Player))) <= Vector(0, 0.030, 0)))
		== True;
	}
	actions
	{
		Play Effect(Event Player, Explosion Sound, Null, Event Player, 100);

		Apply Impulse(Event Player, Up, First Of(Filtered Array(Global.Clouds[Event Player.Checkpoint], 
		(Distance Between(Position Of(Event Player), Current Array Element[0]) <= Current Array Element[1] + 0.500)))[2], To World, Cancel Contrary Motion);
	}
}
disabled rule("TODO: Bot Condition")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.FreeMode == False;
		Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection] == True;
		Event Player.BotCondition == False;
	}
	actions
	{
		Log To Inspector(Custom String("{0} - Bot condition triggered", Event Player));
		If(Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection]);
			Small Message(Event Player, Custom String("There is a bot here"));
		End;
	}
}
rule("Update Bot Status")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == True;
		Event Player.BotUpdate == True;
	}
	actions
	{
		Event Player.BotUpdate = False;
		Call Subroutine(CancelMomentum);
		
		"TODO: Bots dont use ultimate yet, but killing the bot will break Mercy beam so think it through"
		If(Is Using Ultimate(Event Player) && False);
			Call Subroutine(CancelUltimate);
		End;

		If(Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][3]);
			Stop Holding Button(Event Player, Button(Jump));
			disabled Clear Status(Event Player, Rooted);
			Set Gravity(Event Player, 100);
			Else;
				If(Hero Of(Event Player) == Hero(Mercy));
					Start Holding Button(Event Player, Button(Jump));
				End;
				Set Gravity(Event Player, 0);
				disabled Set Status(Event Player.Bot, Null, Rooted, 9999);
				"TODO: Refactor this to use the same function as the player, dont copy paste"
				Call Subroutine(CancelMomentum);
			End;
			Teleport(Event Player, Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][0]);			
			Wait(0.016, Ignore Condition);
		Else;
			Teleport(Event Player, Global.BotPenCoords);
		End;
		If(Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][2]);
			Start Holding Button(Event Player, Button(Crouch));
		Else;
			Stop Holding Button(Event Player, Button(Crouch));
		End;
		"TODO: Only used for peace rez levels for now"
		If(Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][4]);
			Kill(Event Player, Null);
		Else;
			Resurrect(Event Player);
		End;
		Loop If Condition Is True;
	}
}

rule("Detect Using Ability 1")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Using Ability 1(Event Player) == True;
		Event Player.Resetting == False;
	}
	actions
	{
		Log To Inspector(Custom String("{0} - Detected using GA", Event Player));

		If(Event Player.FreeMode == False);
			Event Player.Ability1 = False;
			Wait Until(Ability Cooldown(Event Player, Button(Ability 1)) != 0, 9999);

			"This was added to be compatible with TAW's bot sections that have no refresh orb, they advance automatically after using your GA"
			If(Hero Of(Event Player) == Hero(Mercy) && 
				!Is True For Any(Global.RefreshOrbs[Event Player.Checkpoint], Current Array Element[2] == Event Player.CurrentBotSection + 1) && 
				Event Player.BotCondition == True &&
				Event Player.CurrentBotSection < Count Of(Global.Bots[Event Player.Checkpoint]) -1);
					Log To Inspector(Custom String("{0} - Used GA & no refresh orb. advancing bot now", Event Player));
					Event Player.CurrentBotSection += 1;
					Modify Player Variable(Event Player.Bot, CurrentBotSection, Add, 1);
					Call Subroutine(UpdateBotPosition);
					Small Message(Event Player, Custom String("GA {0} refreshed", Ability Icon String(Hero Of(Event Player), Button(Ability 1))));
					Event Player.Ability1 = True;
			"If lvl does not have unlimited GA, set GA status (racing conditions apply)"
			Else If(Global.Checkpoints[Event Player.Checkpoint][7] == False);
				Set Ability 1 Enabled(Event Player, Event Player.Ability1);
			End;
		End;
		"Disable this if you want to set the cooldowns through lobby settings"
		Set Ability Cooldown(Event Player, Button(Ability 1), 0);
		Log To Inspector(Custom String("{0} - Finished using GA", Event Player));
	}
}
rule("Detect Using Mercy Resurrect")
{
	event
	{
		Ongoing - Each Player;
		All;
		Mercy;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Is Using Ability 2(Event Player) == True;
		Event Player.FreeMode == False;
		Event Player.Finished == False;
		disabled Event Player.Resetting == False;
	}
	actions
	{
		Log To Inspector(Custom String("{0} - Detected using Mercy Rez", Event Player));
		Event Player.MercyRezTimer = 0;
		"Start chasing mercy resurrect time"
		Chase Player Variable At Rate(Event Player, MercyRezTimer, 9999, 1, None);
		Wait Until(!Is Using Ability 2(Event Player), 1.750);
		Stop Chasing Player Variable(Event Player, MercyRezTimer);


		If(Absolute Value(Event Player.MercyRezTimer - 1.750) < 0.050);
			Resurrect(Event Player.Bot);
			"TODO: Rework this once we allow other bot ability rewards"
			Small Message(Event Player, 
				Custom String("{0} Resurrected!{1}",
					Global.Settings[10],
					Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][5] ? 
					Custom String(", {0}{1}{2} also refreshed",
						Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][5] ? Ability Icon String(Hero Of(Event Player), Button(Ability 1)) : Empty Array,
						Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][6] ? Ability Icon String(Hero Of(Event Player), Button(Ability 2)) : Empty Array,
						Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][7] ? Ability Icon String(Hero Of(Event Player), Button(Ultimate)) : Empty Array
					) : Empty Array
				)
			);
			Set Ability 1 Enabled(Event Player, Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][5]);
			Set Ability 2 Enabled(Event Player, Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][6]);
			Set Ultimate Ability Enabled(Event Player, Global.Bots[Event Player.Checkpoint][Event Player.CurrentBotSection][7]);
			Event Player.BotCondition = True;
		Else;
			Set Ability 2 Enabled(Event Player, False);
		End;
	}
}
rule("Regen ultimate in FreeMode")
{
	event
	{
		Ongoing - Each Player;
		All;
		All;
	}
	conditions
	{
		Is Dummy Bot(Event Player) == False;
		Event Player.FreeMode == True;
		Ultimate Charge Percent(Event Player) < 100;
		Is Using Ultimate(Event Player) == False;
	}
	actions
	{
		Set Ultimate Charge(Event Player, 100);
	}
}
rule("Player left the lobby, save their progress")
{
	event
	{
		Player Left Match;
		All;
		All;
	}
	actions
	{
		Modify Global Variable(PlayerData, 
		Append To Array,
		Array(Array(
			Custom String("{0}", Event Player), 
			Event Player.Finished,
			Event Player.Checkpoint, 
			Event Player.CurrentRunTime,
			Event Player.Mistakes)
		));
	}
}
