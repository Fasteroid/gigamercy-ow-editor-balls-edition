				Mercy
			}
		}
	}

	workshop
	{
		Debug Mode (Inspector Recording): On
		Edit Mode: Off
		Server Load Widget: On
	}

	extensions
	{
		Beam Effects
		Beam Sounds
		Buff Status Effects
		Buff and Debuff Sounds
		Explosion Sounds
		Play More Effects
		Spawn More Dummy Bots
		Projectiles
	}
}

